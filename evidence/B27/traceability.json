{
  "batch_id": "B27",
  "requirements": [
    {
      "id": "B27-R1",
      "statement": "以渠道×支付方式×地区×币种×设备五维表达能力，未声明的组合默认拒绝",
      "source": "batches/B27.md 目标"
    },
    {
      "id": "B27-R2",
      "statement": "不得静默切换渠道或支付方式；不可用时拒绝而不是改道",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B27-R3",
      "statement": "授权有有效期，过期必须重新授权；捕获不得超过授权金额",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B27-R4",
      "statement": "退款有窗口且必须原路返回；窗口外不得在产品上承诺退款",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B27-R5",
      "statement": "争议窗口与答复时限由渠道设定，错过即判负，且不得自动认赔",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B27-R6",
      "statement": "可收款的币种必须是可结算的币种，且来自受版本控制的货币元数据",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B27-R7",
      "statement": "地区政策不得承诺矩阵无法提供的方式；欧盟强客户认证为法定要求",
      "source": "batches/B27.md 实施要求"
    }
  ],
