{
  "batch_id": "B24",
  "requirements": [
    {
      "id": "B24-R1",
      "statement": "支持公司、租户、项目、环境四级隔离与稳定的调用身份",
      "source": "batches/B24.md 目标"
    },
    {
      "id": "B24-R2",
      "statement": "标识符不透明、不可变、全局唯一",
      "source": "batches/B24.md 目标"
    },
    {
      "id": "B24-R3",
      "statement": "环境之间不共享密钥与数据；测试凭据在 live 无效",
      "source": "policies/non-negotiables.md#7"
    },
    {
      "id": "B24-R4",
      "statement": "生命周期状态机：草稿→活跃→停用→注销→关闭，转移有前置条件",
      "source": "batches/B24.md 目标"
    },
    {
      "id": "B24-R5",
      "statement": "停用停止新支付但保留退款、回调与结算（在途资金必须能落地）",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B24-R6",
      "statement": "关闭必须先完成结算再销毁租户 KEK；账本与审计独立留存",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B24-R7",
      "statement": "隔离由行级安全 + 每租户 KEK + 禁止跨租户引用共同保证",
      "source": "governance/data-architecture.json"
    },
    {
      "id": "B24-R8",
      "statement": "配额按作用域设定，有默认值与硬上限",
      "source": "batches/B24.md 实施要求"
    }
  ],
