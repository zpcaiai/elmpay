  "requirements": [
    {
      "id": "B21-R1",
      "statement": "实现生成、分发、激活、重叠、轮换、撤销、恢复的完整生命周期",
      "source": "batches/B21.md 目标"
    },
    {
      "id": "B21-R2",
      "statement": "轮换必须有重叠期：切换期间新旧材料同时可验证",
      "source": "batches/B21.md 目标"
    },
    {
      "id": "B21-R3",
      "statement": "到期告警提前量足够，且连续自动续期失败必须升级人工",
      "source": "batches/B21.md 目标"
    },
    {
      "id": "B21-R4",
      "statement": "撤销立即生效，不受重叠期保护",
      "source": "policies/non-negotiables.md#7"
    },
    {
      "id": "B21-R5",
      "statement": "域名有注册商锁、DNSSEC 与 CAA，并监控 CT 日志",
      "source": "security/THREAT_MODEL.md"
    },
    {
      "id": "B21-R6",
      "statement": "灾难恢复被演练过、有时限、需法定人数、CA 有离线备份",
      "source": "batches/B21.md 目标"
    },
    {
      "id": "B21-R7",
      "statement": "每一份材料都归属 B20 管理的密钥，HSM 托管的渠道密钥都有到期日",
      "source": "governance/key-management.json"
    }
