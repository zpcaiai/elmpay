  "requirements": [
    {
      "id": "B13-R1",
      "statement": "每张表的归属唯一且与模块注册表一致",
      "source": "policies/non-negotiables.md#1"
    },
    {
      "id": "B13-R2",
      "statement": "租户数据在数据库层强制隔离，不依赖查询作者的记忆",
      "source": "policies/non-negotiables.md#9"
    },
    {
      "id": "B13-R3",
      "statement": "确定分区键与冷热分层，使归档成为分离而不是删除",
      "source": "batches/B13.md 目标"
    },
    {
      "id": "B13-R4",
      "statement": "账本与凭据类数据仅可追加，不可更新或删除",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B13-R5",
      "statement": "确定归档策略且归档必须可校验、可回读",
      "source": "batches/B13.md 目标"
    },
    {
      "id": "B13-R6",
      "statement": "确定未来分片策略，使分片成为搬迁而不是重写",
      "source": "batches/B13.md 目标"
    },
    {
      "id": "B13-R7",
      "statement": "跨租户访问必须有受控通道、审计事件与四眼复核",
      "source": "policies/non-negotiables.md#11"
    }
  ],
