{
  "batch_id": "B29",
  "requirements": [
    {
      "id": "B29-R1",
      "statement": "区分渠道成本、平台服务费、税费与内部成本四类口径",
      "source": "batches/B29.md 目标"
    },
    {
      "id": "B29-R2",
      "statement": "账面模型是估计，不得替代真实资金结算；差异开对账项且不得覆盖",
      "source": "batches/B29.md 目标"
    },
    {
      "id": "B29-R3",
      "statement": "金额与费率全部使用整数最小单位，舍入方式必须声明且余数有归属",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B29-R4",
      "statement": "税费代收代缴、不计入收入，且按服务费计征而非支付金额",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B29-R5",
      "statement": "分账各方之和必须精确等于总额",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B29-R6",
      "statement": "费用币种等于支付币种；跨币种必须有显式汇率记录",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B29-R7",
      "statement": "计量按支付 ID 幂等且可重算，事件保留满足审计与争议需要",
      "source": "policies/non-negotiables.md#3"
    }
  ],
