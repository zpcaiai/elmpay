{
  "batch_id": "B12",
  "requirements": [
    {
      "id": "B12-R1",
      "statement": "在至少一次传递之上达成恰好一次的业务效果",
      "source": "batches/B12.md 目标"
    },
    {
      "id": "B12-R2",
      "statement": "状态变更与事件写入必须在同一事务中，崩溃不得产生虚假事件",
      "source": "policies/non-negotiables.md#4"
    },
    {
      "id": "B12-R3",
      "statement": "建立事件版本策略，新旧版本并行且只允许加法",
      "source": "batches/B12.md 目标"
    },
    {
      "id": "B12-R4",
      "statement": "建立乱序容忍机制，以单调序号而非时钟为准",
      "source": "batches/B12.md 目标"
    },
    {
      "id": "B12-R5",
      "statement": "事件负载不得包含卡数据、凭据或未分级的个人信息",
      "source": "policies/non-negotiables.md#2"
    },
    {
      "id": "B12-R6",
      "statement": "每一条通往成功状态的转移都必须产生可被账本与对账消费的事件",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B12-R7",
      "statement": "投递失败必须进入死信而不是被静默丢弃",
      "source": "batches/B12.md 自动化验证"
    }
  ],
