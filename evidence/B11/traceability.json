{
  "batch_id": "B11",
  "requirements": [
    {
      "id": "B11-R1",
      "statement": "统一版本策略与弃用规则，同一大版本内只允许向后兼容的加法",
      "source": "batches/B11.md 目标"
    },
    {
      "id": "B11-R2",
      "statement": "所有写操作必须携带幂等键，同键不同体必须冲突而非覆盖",
      "source": "policies/non-negotiables.md#4"
    },
    {
      "id": "B11-R3",
      "statement": "统一分页方式，禁止在支付数据上使用偏移分页",
      "source": "batches/B11.md 目标"
    },
    {
      "id": "B11-R4",
      "statement": "统一错误码、HTTP 状态与可重试语义，错误文案不得泄露敏感数据",
      "source": "policies/non-negotiables.md#14"
    },
    {
      "id": "B11-R5",
      "statement": "统一追踪头，追踪与日志不得包含凭据、卡数据或不必要个人信息",
      "source": "batches/B11.md 自动化验证"
    },
    {
      "id": "B11-R6",
      "statement": "渠道回调必须先验签，并声明时间戳容忍与重放窗口",
      "source": "policies/non-negotiables.md#8"
    },
    {
      "id": "B11-R7",
      "statement": "API 暴露的操作不得让调用方冒充已验签渠道事件写入成功状态",
      "source": "policies/non-negotiables.md#3"
    },
    {
      "id": "B11-R8",
      "statement": "破坏性变更必须能被机器检出，而不是依赖记忆",
      "source": "batches/B11.md 目标"
    }
  ],
