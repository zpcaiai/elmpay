{
  "batch_id": "B20",
  "requirements": [
    {
      "id": "B20-R1",
      "statement": "所有渠道私钥、API 密钥与敏感配置由 KMS/HSM 管理",
      "source": "batches/B20.md 目标"
    },
    {
      "id": "B20-R2",
      "statement": "应用只持有短期解密能力，不持有密钥材料",
      "source": "batches/B20.md 目标"
    },
    {
      "id": "B20-R3",
      "statement": "信封加密：一条记录一把数据密钥，密文绑定租户、用途与密钥版本",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B20-R4",
      "statement": "根密钥不可导出、存于 HSM、操作需法定人数",
      "source": "policies/non-negotiables.md#7"
    },
    {
      "id": "B20-R5",
      "statement": "密钥轮换有周期、有重叠期、可紧急轮换，且只重新包裹不重写数据",
      "source": "batches/B20.md 实施要求"
    },
    {
      "id": "B20-R6",
      "statement": "支持密码学销毁：租户下线销毁其 KEK",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B20-R7",
      "statement": "每一次密钥使用都被审计并记录密钥版本",
      "source": "policies/non-negotiables.md#13"
    },
    {
      "id": "B20-R8",
      "statement": "B19 标记为敏感的字段必须有数据密钥保护；承诺不存储的字段不得被加密存储",
      "source": "governance/authorization.json"
    }
  ],
