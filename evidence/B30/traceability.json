{
  "batch_id": "B30",
  "requirements": [
    {
      "id": "B30-R1",
      "statement": "凭证导入、域名验证、回调验证、限额、上线、停用构成有序工作流",
      "source": "batches/B30.md 目标"
    },
    {
      "id": "B30-R2",
      "statement": "工作流可恢复：状态落盘、从最后完成步骤继续、不重放副作用、无手工完成路径",
      "source": "batches/B30.md 目标"
    },
    {
      "id": "B30-R3",
      "statement": "每一步幂等且产出证据",
      "source": "policies/non-negotiables.md#3"
    },
    {
      "id": "B30-R4",
      "statement": "四眼审批绑定内容摘要、会过期、内容变更即作废",
      "source": "policies/non-negotiables.md#3"
    },
    {
      "id": "B30-R5",
      "statement": "凭证导入不可回显且只导入一次，经由 B26 绑定存储",
      "source": "policies/non-negotiables.md#4"
    },
    {
      "id": "B30-R6",
      "statement": "域名验证令牌一次性且有有效期，不接受通配符；回调必须 HTTPS 且不得指向内网",
      "source": "security/THREAT_MODEL.md"
    },
    {
      "id": "B30-R7",
      "statement": "限额必须在上线前存在；停用一人立即生效，恢复需两人",
      "source": "policies/non-negotiables.md#1"
    }
  ],
