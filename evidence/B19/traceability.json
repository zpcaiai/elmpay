    {
      "id": "B19-R5",
      "statement": "卡号与 CVV 对任何角色都不可读，个人信息默认脱敏",
      "source": "policies/non-negotiables.md#4"
    },
    {
      "id": "B19-R6",
      "statement": "授权默认拒绝，允许与拒绝都写入不可变审计并记录规则版本",
      "source": "policies/non-negotiables.md#13"
    },
    {
      "id": "B19-R7",
      "statement": "特权角色清单成为单一事实源，回补 B16/B17/B18 三处硬编码缺口",
      "source": "evidence/B16 §8、evidence/B17 §8、evidence/B18 §8"
    }
