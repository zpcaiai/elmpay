  "requirements": [
    {
      "id": "B31-R1",
      "statement": "行级安全在数据库侧强制，且对表属主同样生效",
      "source": "batches/B31.md 目标"
    },
    {
      "id": "B31-R2",
      "statement": "对象授权按租户前缀受限，不依赖应用拼路径",
      "source": "batches/B31.md 目标"
    },
    {
      "id": "B31-R3",
      "statement": "缓存键与否定缓存都按租户分区",
      "source": "batches/B31.md 目标"
    },
    {
      "id": "B31-R4",
      "statement": "消息信封带租户且消费者必须校验；禁止跨租户扇出",
      "source": "batches/B31.md 目标"
    },
    {
      "id": "B31-R5",
      "statement": "日志必须带租户且载荷脱敏；跨租户聚合需要双人控制的权限",
      "source": "policies/non-negotiables.md#6"
    },
    {
      "id": "B31-R6",
      "statement": "导出过滤写在查询里、一次一个租户、核对行数",
      "source": "batches/B31.md 目标"
    },
    {
      "id": "B31-R7",
      "statement": "每个隔离面都有断言「另一租户被拒」的探针并在 CI 中运行",
      "source": "policies/non-negotiables.md#13"
    }
