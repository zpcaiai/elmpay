{
  "batch_id": "B34",
  "requirements": [
    {"id": "B34-R1",
     "statement": "支持即时捕获、延迟捕获、部分捕获、撤销、关闭与不确定结果查询六个动作",
     "source": "batches/B34.md 目标"},
    {"id": "B34-R2",
     "statement": "部分捕获之后剩余授权必须由显式的 close 释放；过期是兜底而非释放路径，且触发敞口告警",
     "source": "batches/B34.md 实施要求#1 + policies/non-negotiables.md#3"},
    {"id": "B34-R3",
     "statement": "累计捕获金额永不超过授权金额，且以整数最小单位表达",
     "source": "policies/non-negotiables.md#2 + B09 金额模型"},
    {"id": "B34-R4",
     "statement": "已捕获金额大于零时不得撤销；撤销只释放未动过的全额授权",
     "source": "batches/B34.md 自动化验证"},
    {"id": "B34-R5",
     "statement": "终态授权上不得再有捕获、撤销或关闭",
     "source": "batches/B34.md 完成门#4"},
    {"id": "B34-R6",
     "statement": "查询不移动资金状态，未知结果不得落定为成功",
     "source": "policies/non-negotiables.md#1 + B33 未知落定语义"},
    {"id": "B34-R7",
     "statement": "所有移动资金状态的动作必须带幂等键并发出审计事件，且只能由已验签渠道事件或服务端主动查询定责",
     "source": "policies/non-negotiables.md#1,#3 + B23 审计"},
    {"id": "B34-R8",
     "statement": "部分与多次捕获必须以 B27 能力矩阵中声明的渠道能力为前提；授权有效期同样来自该矩阵",
     "source": "governance/provider-capabilities.json (B27)"},
    {"id": "B34-R9",
     "statement": "生命周期的每个结局都必须落在 B10 支付意图状态机已声明的状态上，并由语言中立向量约束各实现给出同一裁决",
     "source": "governance/state-machines.json (B10) + batches/B34.md 完成门#5"}
  ],
