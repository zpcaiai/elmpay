{
  "batch_id": "B18",
  "requirements": [
    {
      "id": "B18-R1",
      "statement": "管理员、财务、客服等特权角色强制 WebAuthn/硬件密钥或等价抗钓鱼认证",
      "source": "batches/B18.md 目标"
    },
    {
      "id": "B18-R2",
      "statement": "高风险操作必须 step-up 重新验证，且断言绑定本次操作摘要",
      "source": "batches/B18.md 实施要求 5"
    },
    {
      "id": "B18-R3",
      "statement": "不存在降级回退路径；短信/推送/TOTP 不得成为特权账号的唯一因素",
      "source": "policies/non-negotiables.md#11"
    },
    {
      "id": "B18-R4",
      "statement": "WebAuthn 断言必须绑定 origin 与 RP ID，挑战一次性且限时",
      "source": "batches/B18.md 目标"
    },
    {
      "id": "B18-R5",
      "statement": "签名计数器回退视为认证器被克隆，必须拒绝",
      "source": "security/THREAT_MODEL.md"
    },
    {
      "id": "B18-R6",
      "statement": "账号恢复不得成为 MFA 的绕过路径（与 B17 恢复路径交叉校验）",
      "source": "governance/identity.json"
    },
    {
      "id": "B18-R7",
      "statement": "零信任要求的 phishing_resistant_mfa 因素必须有真实认证器支撑",
      "source": "governance/zero-trust.json"
    },
    {
      "id": "B18-R8",
      "statement": "特权账号注册至少两个认证器，且限制尝试次数与推送疲劳",
      "source": "batches/B18.md 实施要求 4"
    }
  ],
