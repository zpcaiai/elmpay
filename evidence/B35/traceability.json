{
  "batch_id": "B35",
  "requirements": [
    {"id": "B35-R1",
     "statement": "平台只持有令牌引用与非敏感指纹；PAN、CVV、磁道、PIN、解密后的钱包支付数据与凭证一律不得进入存储、日志、追踪或 CI 制品",
     "source": "batches/B35.md 目标 + policies/non-negotiables.md#4"},
    {"id": "B35-R2",
     "statement": "禁止字段清单是治理数据，每个实现从生成物派生；任何实现不得再持有自己的字面量副本",
     "source": "batches/B35.md 实施要求#1 + 本批次发现的四份互不相同的清单"},
    {"id": "B35-R3",
     "statement": "字段名比对前必须规范化（小写、去分隔符），使同一字段的不同写法归一",
     "source": "batches/B35.md 自动化验证 + 本批次发现的 pan / card_pan 缺口"},
    {"id": "B35-R4",
     "statement": "令牌引用必须是不透明的、绑定签发渠道的、来自允许清单中的 scheme；可被取回的地址不是令牌",
     "source": "batches/B35.md 目标 + architecture/REFERENCE_ARCHITECTURE.md"},
    {"id": "B35-R5",
     "statement": "指纹必须单向、带密钥、按租户隔离，密钥来源为 B20 密钥目录",
     "source": "policies/non-negotiables.md#4 + governance/key-management.json"},
    {"id": "B35-R6",
     "statement": "可展示字段是允许清单而不是禁止清单，且不得与禁止清单相交",
     "source": "batches/B35.md 自动化验证"},
    {"id": "B35-R7",
     "statement": "令牌引用与指纹的保留期有界，随租户数据生命周期删除",
     "source": "batches/B35.md 实施要求#2 + B13 数据所有权"},
    {"id": "B35-R8",
     "statement": "所有存储的支付方式引用按 tenant_id 隔离，指纹只在租户内唯一",
     "source": "policies/non-negotiables.md#3 + B31 租户隔离"},
    {"id": "B35-R9",
     "statement": "引用支付方式必须发出审计事件；卡数据被拒绝的路径必须 fail closed",
     "source": "policies/non-negotiables.md#6 + B23 审计"}
  ],
