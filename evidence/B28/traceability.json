{
  "batch_id": "B28",
  "requirements": [
    {
      "id": "B28-R1",
      "statement": "路由是确定性的：同输入同版本必得同决定，并可重放",
      "source": "batches/B28.md 目标"
    },
    {
      "id": "B28-R2",
      "statement": "按优先级确定性匹配规则；优先级不得重复；目标渠道必须具备相应能力",
      "source": "batches/B28.md 目标"
    },
    {
      "id": "B28-R3",
      "statement": "成本/成功率/风险三因子加权，成功率需足够样本且保留探索下限",
      "source": "batches/B28.md 目标"
    },
    {
      "id": "B28-R4",
      "statement": "配置版本不可变、决定记录版本号、生效需双人审批并可审计",
      "source": "policies/non-negotiables.md#3"
    },
    {
      "id": "B28-R5",
      "statement": "灰度按支付意图稳定哈希分流，重试不得换分支；自动放量关闭、自动回滚打开",
      "source": "policies/non-negotiables.md#3"
    },
    {
      "id": "B28-R6",
      "statement": "回滚是切回已有版本、无需审批且有时限",
      "source": "batches/B28.md 目标"
    },
    {
      "id": "B28-R7",
      "statement": "影子评估读生产配置但不得产生任何资金动作；重试复用幂等键且不换渠道",
      "source": "policies/non-negotiables.md#1"
    }
  ],
