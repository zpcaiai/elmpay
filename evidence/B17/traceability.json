{
  "batch_id": "B17",
  "requirements": [
    {
      "id": "B17-R1",
      "statement": "实现 OIDC/OAuth2，只允许授权码 + PKCE，禁止隐式与密码流",
      "source": "batches/B17.md 目标"
    },
    {
      "id": "B17-R2",
      "statement": "实现工作负载身份，服务不得持有静态密钥",
      "source": "policies/non-negotiables.md#7"
    },
    {
      "id": "B17-R3",
      "statement": "所有凭证短期有效且可撤销",
      "source": "batches/B17.md 目标"
    },
    {
      "id": "B17-R4",
      "statement": "会话绑定到持有者密钥，被复制的令牌不可用",
      "source": "batches/B17.md 目标"
    },
    {
      "id": "B17-R5",
      "statement": "账号恢复安全：不得降级、不得仅短信、高权限需冷静期与通知",
      "source": "batches/B17.md 目标"
    },
    {
      "id": "B17-R6",
      "statement": "每个零信任主体都必须有可撤销的身份来源",
      "source": "governance/zero-trust.json"
    },
    {
      "id": "B17-R7",
      "statement": "重定向 URI 精确匹配，防止开放重定向",
      "source": "policies/non-negotiables.md#10"
    }
  ],
