{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmpay.example/runtime/worker-scheduler.env.schema.json",
  "title": "ELMPay worker scheduler environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ELMPAY_WORKER_ID",
    "ELMPAY_DATABASE_URL",
    "ELMPAY_DATABASE_USERNAME",
    "ELMPAY_DATABASE_PASSWORD_FILE",
    "ELMPAY_DATABASE_CA_FILE",
    "ELMPAY_DATABASE_CLIENT_CERTIFICATE_FILE",
    "ELMPAY_DATABASE_CLIENT_PRIVATE_KEY_FILE",
    "ELMPAY_ADMIN_ACTION_POLICY_BINDING_FILE",
    "ELMPAY_WORKER_POLL_INTERVAL",
    "ELMPAY_WORKER_READINESS_MAX_STALENESS",
    "ELMPAY_WORKER_MAX_SCOPES",
    "ELMPAY_ADMIN_COMMAND_MAX_PER_CYCLE",
    "ELMPAY_ADMIN_COMMAND_LEASE_TTL",
    "ELMPAY_WORKER_MAX_OUTBOX_PER_TENANT",
    "ELMPAY_WORKER_MAX_TIMELINE_BATCHES",
    "ELMPAY_WORKER_MAX_BILLING_ITEMS",
    "ELMPAY_RECONCILIATION_PROVIDERS",
    "ELMPAY_RECONCILIATION_NOT_BEFORE_DELAY",
    "ELMPAY_RECONCILIATION_MAX_JOBS_PER_TENANT",
    "ELMPAY_RECONCILIATION_MAX_FACTS",
    "ELMPAY_RECONCILIATION_JOB_LEASE_TTL",
    "ELMPAY_WORKER_PARTITION_MONTHS_AHEAD",
    "ELMPAY_WORKER_PARTITION_ACTOR_ID",
    "ELMPAY_WORKER_PARTITION_TICKET_ID",
    "ELMPAY_WORKER_HEALTH_HOST",
    "ELMPAY_WORKER_HEALTH_PORT",
    "ELMPAY_EVENT_OUTBOX_LEASE_TTL",
    "ELMPAY_EVENT_PUBLISHER_BASE_BACKOFF",
    "ELMPAY_EVENT_INBOX_LEASE_TTL",
    "ELMPAY_EVENT_INBOX_RETRY_DELAY",
    "ELMPAY_PAYMENT_TIMELINE_PROJECTOR",
    "ELMPAY_PAYMENT_TIMELINE_BATCH_SIZE",
    "ELMPAY_PAYMENT_TIMELINE_MAXIMUM_BATCHES",
    "ELMPAY_KAFKA_BOOTSTRAP_SERVERS",
    "ELMPAY_KAFKA_TOPIC",
    "ELMPAY_KAFKA_CLIENT_ID",
    "ELMPAY_KAFKA_TRUSTSTORE_FILE",
    "ELMPAY_KAFKA_TRUSTSTORE_PASSWORD_FILE",
    "ELMPAY_KAFKA_KEYSTORE_FILE",
    "ELMPAY_KAFKA_KEYSTORE_PASSWORD_FILE",
    "ELMPAY_KAFKA_ACK_TIMEOUT",
    "ELMPAY_KAFKA_LEDGER_CONSUMER_GROUP_ID",
    "ELMPAY_KAFKA_CONSUMER_MAX_POLL_RECORDS",
    "ELMPAY_KAFKA_CONSUMER_POLL_TIMEOUT"
  ],
  "properties": {
    "ELMPAY_WORKER_ID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "ELMPAY_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://", "maxLength": 2048},
    "ELMPAY_DATABASE_USERNAME": {"const": "elmpay_worker"},
    "ELMPAY_DATABASE_PASSWORD_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CA_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CLIENT_CERTIFICATE_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CLIENT_PRIVATE_KEY_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_ADMIN_ACTION_POLICY_BINDING_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_WORKER_POLL_INTERVAL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WORKER_READINESS_MAX_STALENESS": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WORKER_MAX_SCOPES": {"type": "string", "pattern": "^[1-9][0-9]{0,3}$|^10000$"},
    "ELMPAY_ADMIN_COMMAND_MAX_PER_CYCLE": {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"},
    "ELMPAY_ADMIN_COMMAND_LEASE_TTL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WORKER_MAX_OUTBOX_PER_TENANT": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$|^1000$"},
    "ELMPAY_WORKER_MAX_TIMELINE_BATCHES": {"type": "string", "pattern": "^[1-9][0-9]{0,3}$|^10000$"},
    "ELMPAY_WORKER_MAX_BILLING_ITEMS": {"type": "string", "pattern": "^[1-9][0-9]{0,3}$|^10000$"},
    "ELMPAY_RECONCILIATION_PROVIDERS": {"type": "string", "pattern": "^(?:wechat|alipay|stripe|paypal|apple_pay)(?:,(?:wechat|alipay|stripe|paypal|apple_pay)){0,4}$", "maxLength": 64},
    "ELMPAY_RECONCILIATION_NOT_BEFORE_DELAY": {"type": "string", "pattern": "^PT"},
    "ELMPAY_RECONCILIATION_MAX_JOBS_PER_TENANT": {"type": "string", "pattern": "^[1-5]$"},
    "ELMPAY_RECONCILIATION_MAX_FACTS": {"type": "string", "pattern": "^(?:[1-9][0-9]{0,5}|1000000)$"},
    "ELMPAY_RECONCILIATION_JOB_LEASE_TTL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WORKER_PARTITION_MONTHS_AHEAD": {"type": "string", "pattern": "^(?:[1-9]|1[0-9]|2[0-3])$"},
    "ELMPAY_WORKER_PARTITION_ACTOR_ID": {"type": "string", "maxLength": 128},
    "ELMPAY_WORKER_PARTITION_TICKET_ID": {"type": "string", "maxLength": 128},
    "ELMPAY_WORKER_HEALTH_HOST": {"type": "string", "maxLength": 253},
    "ELMPAY_WORKER_HEALTH_PORT": {"type": "string", "pattern": "^[1-9][0-9]{0,4}$"},
    "ELMPAY_EVENT_OUTBOX_LEASE_TTL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_EVENT_PUBLISHER_BASE_BACKOFF": {"type": "string", "pattern": "^PT"},
    "ELMPAY_EVENT_INBOX_LEASE_TTL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_EVENT_INBOX_RETRY_DELAY": {"type": "string", "pattern": "^PT"},
    "ELMPAY_PAYMENT_TIMELINE_PROJECTOR": {"type": "string", "maxLength": 128},
    "ELMPAY_PAYMENT_TIMELINE_BATCH_SIZE": {"type": "string", "pattern": "^[1-9][0-9]{0,2}$|^1000$"},
    "ELMPAY_PAYMENT_TIMELINE_MAXIMUM_BATCHES": {"type": "string", "pattern": "^[1-9][0-9]{0,3}$|^10000$"},
    "ELMPAY_KAFKA_BOOTSTRAP_SERVERS": {"type": "string", "minLength": 15, "maxLength": 4096},
    "ELMPAY_KAFKA_TOPIC": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,248}$"},
    "ELMPAY_KAFKA_CLIENT_ID": {"type": "string", "maxLength": 128},
    "ELMPAY_KAFKA_TRUSTSTORE_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_KAFKA_TRUSTSTORE_PASSWORD_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_KAFKA_KEYSTORE_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_KAFKA_KEYSTORE_PASSWORD_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_KAFKA_ACK_TIMEOUT": {"type": "string", "pattern": "^PT"},
    "ELMPAY_KAFKA_LEDGER_CONSUMER_GROUP_ID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "ELMPAY_KAFKA_CONSUMER_MAX_POLL_RECORDS": {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]|[1-4][0-9]{2}|500)$"},
    "ELMPAY_KAFKA_CONSUMER_POLL_TIMEOUT": {"type": "string", "pattern": "^PT"}
  }
}
