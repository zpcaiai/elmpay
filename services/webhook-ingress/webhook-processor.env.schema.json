{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmpay.example/runtime/webhook-processor.env.schema.json",
  "title": "ELMPay verified provider webhook processor environment",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ELMPAY_WEBHOOK_PROCESSOR_ID",
    "ELMPAY_DATABASE_URL",
    "ELMPAY_DATABASE_USERNAME",
    "ELMPAY_DATABASE_PASSWORD_FILE",
    "ELMPAY_DATABASE_CA_FILE",
    "ELMPAY_DATABASE_CLIENT_CERTIFICATE_FILE",
    "ELMPAY_DATABASE_CLIENT_PRIVATE_KEY_FILE",
    "ELMPAY_WEBHOOK_PROCESSOR_POLL_INTERVAL",
    "ELMPAY_WEBHOOK_PROCESSOR_READINESS_MAX_STALENESS",
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_TENANTS",
    "ELMPAY_WEBHOOK_PROCESSOR_LEASE_TTL",
    "ELMPAY_WEBHOOK_PROCESSOR_BASE_BACKOFF",
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_BACKOFF",
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_ATTEMPTS",
    "ELMPAY_WEBHOOK_PROCESSOR_HEALTH_HOST",
    "ELMPAY_WEBHOOK_PROCESSOR_HEALTH_PORT"
  ],
  "properties": {
    "ELMPAY_WEBHOOK_PROCESSOR_ID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "ELMPAY_DATABASE_URL": {"type": "string", "pattern": "^jdbc:postgresql://", "maxLength": 2048},
    "ELMPAY_DATABASE_USERNAME": {"const": "elmpay_webhook_processor"},
    "ELMPAY_DATABASE_PASSWORD_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CA_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CLIENT_CERTIFICATE_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_DATABASE_CLIENT_PRIVATE_KEY_FILE": {"type": "string", "pattern": "^/"},
    "ELMPAY_WEBHOOK_PROCESSOR_POLL_INTERVAL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WEBHOOK_PROCESSOR_READINESS_MAX_STALENESS": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_TENANTS": {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]{1,2}|1000)$"},
    "ELMPAY_WEBHOOK_PROCESSOR_LEASE_TTL": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WEBHOOK_PROCESSOR_BASE_BACKOFF": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_BACKOFF": {"type": "string", "pattern": "^PT"},
    "ELMPAY_WEBHOOK_PROCESSOR_MAX_ATTEMPTS": {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]|100)$"},
    "ELMPAY_WEBHOOK_PROCESSOR_HEALTH_HOST": {"enum": ["0.0.0.0", "127.0.0.1", "::", "::1"]},
    "ELMPAY_WEBHOOK_PROCESSOR_HEALTH_PORT": {"type": "string", "pattern": "^[1-9][0-9]{0,4}$"}
  }
}
