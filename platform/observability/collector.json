{
  "receivers": {
    "otlp": {
      "protocols": {
        "grpc": { "endpoint": "0.0.0.0:4317" },
        "http": { "endpoint": "0.0.0.0:4318" }
      }
    }
  },
  "processors": {
    "memory_limiter": {
      "check_interval": "1s",
      "limit_mib": 384,
      "spike_limit_mib": 96
    },
    "attributes/redact": {
      "actions": [
        { "key": "payment.card.number", "action": "delete" },
        { "key": "payment.card.cvv", "action": "delete" },
        { "key": "http.request.header.authorization", "action": "delete" },
        { "key": "enduser.email", "action": "delete" },
        { "key": "db.statement", "action": "delete" }
      ]
    },
    "resource/required": {
      "attributes": [
        { "key": "deployment.environment", "value": "production", "action": "upsert" }
      ]
    },
    "batch": { "send_batch_size": 1024, "timeout": "5s" }
  },
  "exporters": {
    "otlp/primary": {
      "endpoint": "${env:ELMPAY_OTEL_PRIMARY_ENDPOINT}",
      "tls": { "insecure": false, "ca_file": "${env:ELMPAY_OTEL_CA_FILE}" },
      "sending_queue": { "enabled": true, "queue_size": 10000 },
      "retry_on_failure": { "enabled": true, "max_elapsed_time": "300s" }
    },
    "otlp/siem": {
      "endpoint": "${env:ELMPAY_SIEM_ENDPOINT}",
      "tls": { "insecure": false, "ca_file": "${env:ELMPAY_SIEM_CA_FILE}" },
      "sending_queue": { "enabled": true, "queue_size": 10000 }
    }
  },
  "service": {
    "telemetry": { "logs": { "level": "info" } },
    "pipelines": {
      "traces": {
        "receivers": ["otlp"],
        "processors": ["memory_limiter", "attributes/redact", "resource/required", "batch"],
        "exporters": ["otlp/primary"]
      },
      "metrics": {
        "receivers": ["otlp"],
        "processors": ["memory_limiter", "attributes/redact", "resource/required", "batch"],
        "exporters": ["otlp/primary"]
      },
      "logs": {
        "receivers": ["otlp"],
        "processors": ["memory_limiter", "attributes/redact", "resource/required", "batch"],
        "exporters": ["otlp/primary", "otlp/siem"]
      }
    }
  }
}
