{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmpay.example/security/provider-evidence-trust-v1.json",
  "title": "ELMPay provider evidence trust",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId", "algorithm", "publicKeyPem", "identity", "provider",
          "evidenceTypes", "notBefore", "notAfter", "revoked"
        ],
        "properties": {
          "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "algorithm": {"const": "Ed25519"},
          "publicKeyPem": {"type": "string", "maxLength": 8192},
          "identity": {"type": "string", "minLength": 1, "maxLength": 160},
          "provider": {
            "enum": ["wechat", "alipay", "stripe", "paypal", "apple_pay"]
          },
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "PROVIDER_DISPUTE_EVENT", "PROVIDER_DISPUTE_RESULT",
                "PROVIDER_RENEWAL_RESULT", "PROVIDER_DUNNING_RESULT"
              ]
            }
          },
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"}
        }
      }
    }
  }
}
