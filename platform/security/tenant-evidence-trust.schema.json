{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.elmpay.example/security/tenant-evidence-trust-v1.json",
  "title": "ELMPay tenant authority evidence trust",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "keyId", "algorithm", "publicKeyPem", "signerIdentity", "authority",
          "evidenceTypes", "notBefore", "notAfter", "revoked"
        ],
        "properties": {
          "keyId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
          "algorithm": {"const": "Ed25519"},
          "publicKeyPem": {"type": "string", "maxLength": 8192},
          "signerIdentity": {"type": "string", "minLength": 1, "maxLength": 160},
          "authority": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{2,159}$"
          },
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "KYB_VERIFIED", "CONTRACT_SIGNED", "SETTLEMENT_COMPLETE",
                "RETENTION_PERIOD_STARTED", "KEK_DESTROYED"
              ]
            }
          },
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"},
          "revoked": {"type": "boolean"}
        }
      }
    }
  }
}
