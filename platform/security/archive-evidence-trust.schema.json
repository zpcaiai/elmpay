{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elmpay.example/schemas/archive-evidence-trust-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "keys"],
  "properties": {
    "schemaVersion": {"const": 1},
    "keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyId", "algorithm", "publicKeyDerBase64", "notBefore", "notAfter", "status", "role", "subjectId"],
        "properties": {
          "keyId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"},
          "algorithm": {"const": "Ed25519"},
          "publicKeyDerBase64": {"type": "string", "minLength": 44, "maxLength": 256},
          "notBefore": {"type": "string", "format": "date-time"},
          "notAfter": {"type": "string", "format": "date-time"},
          "status": {"enum": ["ACTIVE", "REVOKED"]},
          "role": {"enum": ["TENANT_EXPORT_ATTESTOR", "PARTITION_RELEASE_APPROVER", "DETACH_ACTOR", "DETACH_APPROVER"]},
          "subjectId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"}
        }
      }
    }
  }
}
