{
  "schemaVersion": 1,
  "namespace": "elmpay",
  "dns": {
    "namespace": "kube-system",
    "podLabels": {
      "k8s-app": "kube-dns"
    }
  },
  "destinations": [
    {
      "id": "postgres-primary",
      "category": "DATABASE",
      "type": "service",
      "namespace": "elmpay-cn-east-1",
      "serviceName": "payments-postgres-rw",
      "podLabels": {
        "cnpg.io/cluster": "payments-postgres"
      },
      "port": 5432,
      "protocol": "TLS"
    },
    {
      "id": "kafka-events",
      "category": "KAFKA",
      "type": "service",
      "namespace": "elmpay-cn-east-1",
      "serviceName": "payments-events-kafka-bootstrap",
      "additionalServiceNames": [
        "payments-events-kafka-brokers"
      ],
      "dnsNames": [
        "payments-events-kafka-0.payments-events-kafka-brokers.elmpay-cn-east-1.svc.cluster.local",
        "payments-events-kafka-1.payments-events-kafka-brokers.elmpay-cn-east-1.svc.cluster.local",
        "payments-events-kafka-2.payments-events-kafka-brokers.elmpay-cn-east-1.svc.cluster.local"
      ],
      "podLabels": {
        "strimzi.io/cluster": "payments-events"
      },
      "port": 9093,
      "protocol": "TLS"
    },
    {
      "id": "redis-cache",
      "category": "REDIS",
      "type": "service",
      "namespace": "elmpay-cn-east-1",
      "serviceName": "payments-cache",
      "podLabels": {
        "app.kubernetes.io/name": "payments-cache"
      },
      "port": 6379,
      "protocol": "TCP"
    },
    {
      "id": "kms-broker",
      "category": "KMS",
      "type": "service",
      "namespace": "security",
      "serviceName": "kms-broker",
      "podLabels": {
        "app.kubernetes.io/name": "kms-broker"
      },
      "port": 8443,
      "protocol": "TLS"
    },
    {
      "id": "otel-collector",
      "category": "OTEL",
      "type": "service",
      "namespace": "observability",
      "serviceName": "otel-collector",
      "podLabels": {
        "app.kubernetes.io/name": "otel-collector"
      },
      "port": 4317,
      "protocol": "TLS"
    },
    {
      "id": "edge-gateway-internal",
      "category": "INTERNAL_API",
      "type": "service",
      "namespace": "elmpay",
      "serviceName": "edge-gateway",
      "targetWorkload": "edge-gateway",
      "podLabels": {
        "app.kubernetes.io/name": "edge-gateway"
      },
      "port": 8443,
      "protocol": "TLS"
    },
    {
      "id": "risk-engine-internal",
      "category": "INTERNAL_API",
      "type": "service",
      "namespace": "elmpay",
      "serviceName": "risk-engine",
      "targetWorkload": "risk-engine",
      "podLabels": {
        "app.kubernetes.io/name": "risk-engine"
      },
      "port": 8443,
      "protocol": "TLS"
    },
    {
      "id": "risk-signal-service",
      "category": "RISK_SIGNAL",
      "type": "service",
      "namespace": "risk-platform",
      "serviceName": "risk-signal",
      "podLabels": {
        "app.kubernetes.io/name": "risk-signal"
      },
      "port": 8443,
      "protocol": "TLS"
    },
    {
      "id": "risk-model-service",
      "category": "RISK_MODEL",
      "type": "service",
      "namespace": "risk-platform",
      "serviceName": "risk-model",
      "podLabels": {
        "app.kubernetes.io/name": "risk-model"
      },
      "port": 8443,
      "protocol": "TLS"
    },
    {
      "id": "wechat-api",
      "category": "PSP",
      "type": "fqdn",
      "host": "api.mch.weixin.qq.com",
      "port": 443,
      "protocol": "TLS"
    },
    {
      "id": "alipay-api",
      "category": "PSP",
      "type": "fqdn",
      "host": "openapi.alipay.com",
      "port": 443,
      "protocol": "TLS"
    },
    {
      "id": "stripe-api",
      "category": "PSP",
      "type": "fqdn",
      "host": "api.stripe.com",
      "port": 443,
      "protocol": "TLS"
    },
    {
      "id": "paypal-api",
      "category": "PSP",
      "type": "fqdn",
      "host": "api-m.paypal.com",
      "port": 443,
      "protocol": "TLS"
    }
  ],
  "workloads": {
    "admin-web": [
      "postgres-primary",
      "edge-gateway-internal"
    ],
    "checkout-web": [
      "otel-collector",
      "edge-gateway-internal"
    ],
    "edge-gateway": [
      "postgres-primary",
      "kafka-events",
      "redis-cache",
      "kms-broker",
      "otel-collector",
      "wechat-api",
      "alipay-api",
      "stripe-api",
      "paypal-api",
      "risk-engine-internal"
    ],
    "risk-engine": [
      "postgres-primary",
      "risk-signal-service",
      "risk-model-service"
    ],
    "worker-scheduler": [
      "postgres-primary",
      "kafka-events"
    ],
    "webhook-processor": [
      "postgres-primary"
    ]
  }
}
