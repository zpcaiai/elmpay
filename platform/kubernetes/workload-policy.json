        "ELMPAY_PROVIDER_CREDENTIAL_MTLS_CLIENT_KEY_FILE": "/var/run/secrets/elmpay/provider-tls/tls.key",
        "ELMPAY_PROVIDER_CREDENTIAL_MTLS_TRUST_BUNDLE_FILE": "/var/run/secrets/elmpay/provider-tls/ca.crt",
        "ELMPAY_APPLE_PAY_PSP_MTLS_CLIENT_CERT_FILE": "/var/run/secrets/elmpay/provider-tls/tls.crt",
        "ELMPAY_APPLE_PAY_PSP_MTLS_CLIENT_KEY_FILE": "/var/run/secrets/elmpay/provider-tls/tls.key",
        "ELMPAY_APPLE_PAY_PSP_MTLS_TRUST_BUNDLE_FILE": "/var/run/secrets/elmpay/provider-tls/ca.crt",
        "ELMPAY_PROVIDER_EVIDENCE_TRUST_FILE": "/var/run/secrets/elmpay/evidence-trust/provider-trust.json",
        "ELMPAY_TENANT_EVIDENCE_TRUST_FILE": "/var/run/secrets/elmpay/evidence-trust/tenant-trust.json",
