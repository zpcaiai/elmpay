          {"name": "archive-detacher-database-credentials", "secretName": "archive-detacher-database-credentials", "mountPath": "/var/run/secrets/elmpay/archive-detacher-database-credentials"},
          {"name": "archive-detacher-database-mtls", "secretName": "archive-detacher-database-mtls", "mountPath": "/var/run/secrets/elmpay/archive-detacher-database-mtls"},
