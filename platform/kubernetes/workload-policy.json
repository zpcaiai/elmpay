        "ELMPAY_DATABASE_CA_FILE": "/var/run/secrets/elmpay/edge-database-mtls/ca.crt",
        "ELMPAY_DATABASE_CLIENT_CERTIFICATE_FILE": "/var/run/secrets/elmpay/edge-database-mtls/tls.crt",
        "ELMPAY_DATABASE_CLIENT_PRIVATE_KEY_FILE": "/var/run/secrets/elmpay/edge-database-mtls/tls.key",
        "ELMPAY_DATABASE_USERNAME": "elmpay_edge_gateway",
        "ELMPAY_ADMIN_ACTION_POLICY_BINDING_FILE": "/var/run/secrets/elmpay/edge-admin-governance/policy-binding.json",
