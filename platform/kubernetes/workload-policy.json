{
  "schemaVersion": 2,
  "namespace": "elmpay",
  "dnsEgress": {
    "namespace": "kube-system",
    "podLabels": {
      "k8s-app": "kube-dns"
    }
  },
  "jobs": [
    {
      "name": "database-migrator",
      "serviceAccount": "database-migrator",
      "imageFrom": "edge-gateway",
      "cpuRequest": "100m",
      "cpuLimit": "500m",
      "memoryRequest": "128Mi",
      "memoryLimit": "384Mi",
      "activeDeadlineSeconds": 900,
      "gitOps": {
        "phase": "PreSync",
        "dependencyWave": -20,
        "executionWave": -10,
        "requiresDrainedDatabaseRoles": [
          "elmpay_edge_gateway",
          "elmpay_risk_engine",
          "elmpay_worker"
        ]
      },
      "runtime": {
        "kind": "java-job",
        "entrypoint": "apps/edge-gateway/src/main/java/com/elmpay/gateway/DatabaseMigrationApplication.java",
        "launcher": "/opt/elmpay/bin/java-main",
        "mainClass": "com.elmpay.gateway.DatabaseMigrationApplication",
        "modeEnvironment": "ELMPAY_MIGRATION_MODE",
        "modeValue": "apply"
      },
      "fixedEnvironment": {
        "ELMPAY_MIGRATION_MODE": "apply",
        "ELMPAY_MIGRATION_DATABASE_USERNAME": "elmpay_migrator",
        "ELMPAY_MIGRATION_DATABASE_PASSWORD_FILE": "/var/run/secrets/elmpay/migration-database-credentials/password",
        "ELMPAY_MIGRATION_DATABASE_CA_FILE": "/var/run/secrets/elmpay/migration-database-mtls/ca.crt",
        "ELMPAY_MIGRATION_DATABASE_CLIENT_CERTIFICATE_FILE": "/var/run/secrets/elmpay/migration-database-mtls/tls.crt",
        "ELMPAY_MIGRATION_DATABASE_CLIENT_PRIVATE_KEY_FILE": "/var/run/secrets/elmpay/migration-database-mtls/tls.key"
      },
      "configuration": {
        "configMap": "database-migrator-runtime",
        "configMapData": {
          "ELMPAY_MIGRATION_DATABASE_URL": "jdbc:postgresql://payments-postgres-rw.elmpay-cn-east-1.svc.cluster.local:5432/elmpay"
        },
        "secretMounts": [
          {
            "name": "migration-database-credentials",
            "secretName": "database-migrator-credentials",
            "mountPath": "/var/run/secrets/elmpay/migration-database-credentials"
          },
          {
            "name": "migration-database-mtls",
            "secretName": "database-migrator-mtls",
            "mountPath": "/var/run/secrets/elmpay/migration-database-mtls"
          }
        ]
      },
      "databaseEgress": {
        "namespace": "elmpay-cn-east-1",
        "podLabels": {
          "cnpg.io/cluster": "payments-postgres"
        },
        "port": 5432
      }
    },
    {
      "name": "tenant-partition-initializer",
      "serviceAccount": "tenant-partition-initializer",
      "imageFrom": "worker-scheduler",
      "cpuRequest": "100m",
      "cpuLimit": "500m",
      "memoryRequest": "128Mi",
      "memoryLimit": "384Mi",
      "activeDeadlineSeconds": 600,
      "gitOps": {
        "phase": "PreSync",
        "dependencyWave": -20,
        "executionWave": -5,
        "requiresDrainedDatabaseRoles": [
          "elmpay_edge_gateway",
          "elmpay_risk_engine",
          "elmpay_worker"
        ]
      },
      "runtime": {
        "kind": "java-job",
        "entrypoint": "services/worker-scheduler/src/main/java/com/elmpay/scheduler/data/PartitionMaintenanceApplication.java",
        "launcher": "/opt/elmpay/bin/java-main",
        "mainClass": "com.elmpay.scheduler.data.PartitionMaintenanceApplication",
        "modeEnvironment": "ELMPAY_PARTITION_MODE",
        "modeValue": "precreate"
      },
      "fixedEnvironment": {
        "ELMPAY_PARTITION_MODE": "precreate",
        "ELMPAY_PARTITION_DATABASE_USERNAME": "elmpay_partition_precreator",
        "ELMPAY_PARTITION_DATABASE_PASSWORD_FILE": "/var/run/secrets/elmpay/partition-database-credentials/password",
        "ELMPAY_PARTITION_DATABASE_CA_FILE": "/var/run/secrets/elmpay/partition-database-mtls/ca.crt",
        "ELMPAY_PARTITION_DATABASE_CLIENT_CERTIFICATE_FILE": "/var/run/secrets/elmpay/partition-database-mtls/tls.crt",
        "ELMPAY_PARTITION_DATABASE_CLIENT_PRIVATE_KEY_FILE": "/var/run/secrets/elmpay/partition-database-mtls/tls.key",
        "ELMPAY_PARTITION_ACTOR_ID": "gitops-partition-precreator",
        "ELMPAY_PARTITION_TICKET_ID": "governed-partition-horizon"
      },
      "configuration": {
        "configMap": "tenant-partition-initializer-runtime",
        "configMapData": {
          "ELMPAY_PARTITION_DATABASE_URL": "jdbc:postgresql://payments-postgres-rw.elmpay-cn-east-1.svc.cluster.local:5432/elmpay",
          "ELMPAY_PARTITION_MONTHS_AHEAD": "12"
        },
        "secretMounts": [
          {
            "name": "partition-database-credentials",
            "secretName": "partition-database-credentials",
            "mountPath": "/var/run/secrets/elmpay/partition-database-credentials"
          },
          {
            "name": "partition-database-mtls",
            "secretName": "partition-database-mtls",
            "mountPath": "/var/run/secrets/elmpay/partition-database-mtls"
          }
        ]
      },
      "databaseEgress": {
        "namespace": "elmpay-cn-east-1",
        "podLabels": {
          "cnpg.io/cluster": "payments-postgres"
        },
        "port": 5432
      }
    },
    {
      "name": "archive-receipt-verifier",
      "serviceAccount": "archive-receipt-verifier",
      "imageFrom": "worker-scheduler",
      "cpuRequest": "100m",
      "cpuLimit": "500m",
      "memoryRequest": "128Mi",
      "memoryLimit": "384Mi",
      "activeDeadlineSeconds": 900,
      "manualExecution": {
        "suspend": true,
        "evidenceState": "EVIDENCE_PENDING"
      },
      "runtime": {
        "kind": "java-job",
        "entrypoint": "services/worker-scheduler/src/main/java/com/elmpay/scheduler/data/ArchiveReceiptVerifierApplication.java",
        "launcher": "/opt/elmpay/bin/java-main",
        "mainClass": "com.elmpay.scheduler.data.ArchiveReceiptVerifierApplication",
        "modeEnvironment": "ELMPAY_ARCHIVE_RECEIPT_MODE",
        "modeValue": "verify-and-ingest"
      },
      "fixedEnvironment": {
        "ELMPAY_ARCHIVE_RECEIPT_MODE": "verify-and-ingest",
        "ELMPAY_ARCHIVE_DATABASE_USERNAME": "elmpay_archive_verifier",
        "ELMPAY_ARCHIVE_DATABASE_PASSWORD_FILE": "/var/run/secrets/elmpay/archive-verifier-database-credentials/password",
        "ELMPAY_ARCHIVE_DATABASE_CA_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/ca.crt",
        "ELMPAY_ARCHIVE_DATABASE_CLIENT_CERTIFICATE_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/tls.crt",
        "ELMPAY_ARCHIVE_DATABASE_CLIENT_PRIVATE_KEY_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/tls.key",
        "ELMPAY_ARCHIVE_TRUST_FILE": "/var/run/secrets/elmpay/archive-verifier-trust/trust.json",
        "ELMPAY_ARCHIVE_RECEIPT_BUNDLE_FILE": "/var/run/secrets/elmpay/archive-receipt-bundle/bundle.json"
      },
      "configuration": {
        "configMap": "archive-receipt-verifier-runtime",
        "configMapData": {
          "ELMPAY_ARCHIVE_DATABASE_URL": "jdbc:postgresql://payments-postgres-rw.elmpay-cn-east-1.svc.cluster.local:5432/elmpay"
        },
        "secretMounts": [
          {"name": "archive-verifier-database-credentials", "secretName": "archive-verifier-database-credentials", "mountPath": "/var/run/secrets/elmpay/archive-verifier-database-credentials"},
          {"name": "archive-verifier-database-mtls", "secretName": "archive-verifier-database-mtls", "mountPath": "/var/run/secrets/elmpay/archive-verifier-database-mtls"},
          {"name": "archive-verifier-trust", "secretName": "archive-verifier-trust", "mountPath": "/var/run/secrets/elmpay/archive-verifier-trust"},
          {"name": "archive-receipt-bundle", "secretName": "archive-receipt-bundle", "mountPath": "/var/run/secrets/elmpay/archive-receipt-bundle"}
        ]
      },
      "databaseEgress": {"namespace": "elmpay-cn-east-1", "podLabels": {"cnpg.io/cluster": "payments-postgres"}, "port": 5432}
    },
    {
      "name": "archive-detach-authorization-verifier",
      "serviceAccount": "archive-detach-authorization-verifier",
      "imageFrom": "worker-scheduler",
      "cpuRequest": "100m",
      "cpuLimit": "500m",
      "memoryRequest": "128Mi",
      "memoryLimit": "384Mi",
      "activeDeadlineSeconds": 600,
      "manualExecution": {"suspend": true, "evidenceState": "EVIDENCE_PENDING"},
      "runtime": {
        "kind": "java-job",
        "entrypoint": "services/worker-scheduler/src/main/java/com/elmpay/scheduler/data/ArchiveDetachAuthorizationVerifierApplication.java",
        "launcher": "/opt/elmpay/bin/java-main",
        "mainClass": "com.elmpay.scheduler.data.ArchiveDetachAuthorizationVerifierApplication",
        "modeEnvironment": "ELMPAY_ARCHIVE_DETACH_VERIFIER_MODE",
        "modeValue": "verify-detach-authorization"
      },
      "fixedEnvironment": {
        "ELMPAY_ARCHIVE_DETACH_VERIFIER_MODE": "verify-detach-authorization",
        "ELMPAY_ARCHIVE_DATABASE_USERNAME": "elmpay_archive_verifier",
        "ELMPAY_ARCHIVE_DATABASE_PASSWORD_FILE": "/var/run/secrets/elmpay/archive-verifier-database-credentials/password",
        "ELMPAY_ARCHIVE_DATABASE_CA_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/ca.crt",
        "ELMPAY_ARCHIVE_DATABASE_CLIENT_CERTIFICATE_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/tls.crt",
        "ELMPAY_ARCHIVE_DATABASE_CLIENT_PRIVATE_KEY_FILE": "/var/run/secrets/elmpay/archive-verifier-database-mtls/tls.key",
        "ELMPAY_ARCHIVE_TRUST_FILE": "/var/run/secrets/elmpay/archive-verifier-trust/trust.json",
        "ELMPAY_ARCHIVE_DETACH_POLICY_FILE": "/var/run/secrets/elmpay/archive-detach-policy/policy.json",
        "ELMPAY_ARCHIVE_DETACH_AUTHORIZATION_FILE": "/var/run/secrets/elmpay/archive-detach-authorization/authorization.json"
      },
      "configuration": {
        "configMap": "archive-detach-authorization-verifier-runtime",
        "configMapData": {"ELMPAY_ARCHIVE_DATABASE_URL": "jdbc:postgresql://payments-postgres-rw.elmpay-cn-east-1.svc.cluster.local:5432/elmpay"},
        "secretMounts": [
          {"name": "archive-verifier-database-credentials", "secretName": "archive-verifier-database-credentials", "mountPath": "/var/run/secrets/elmpay/archive-verifier-database-credentials"},
          {"name": "archive-verifier-database-mtls", "secretName": "archive-verifier-database-mtls", "mountPath": "/var/run/secrets/elmpay/archive-verifier-database-mtls"},
          {"name": "archive-verifier-trust", "secretName": "archive-verifier-trust", "mountPath": "/var/run/secrets/elmpay/archive-verifier-trust"},
          {"name": "archive-detach-policy", "secretName": "archive-detach-policy", "mountPath": "/var/run/secrets/elmpay/archive-detach-policy"},
          {"name": "archive-detach-authorization", "secretName": "archive-detach-authorization", "mountPath": "/var/run/secrets/elmpay/archive-detach-authorization"}
        ]
      },
      "databaseEgress": {"namespace": "elmpay-cn-east-1", "podLabels": {"cnpg.io/cluster": "payments-postgres"}, "port": 5432}
    },
    {
      "name": "tenant-partition-detacher",
      "serviceAccount": "tenant-partition-detacher",
      "imageFrom": "worker-scheduler",
      "cpuRequest": "100m",
      "cpuLimit": "500m",
      "memoryRequest": "128Mi",
      "memoryLimit": "384Mi",
      "activeDeadlineSeconds": 600,
      "manualExecution": {"suspend": true, "evidenceState": "EVIDENCE_PENDING"},
      "runtime": {
        "kind": "java-job",
        "entrypoint": "services/worker-scheduler/src/main/java/com/elmpay/scheduler/data/ArchivePartitionDetacherApplication.java",
        "launcher": "/opt/elmpay/bin/java-main",
        "mainClass": "com.elmpay.scheduler.data.ArchivePartitionDetacherApplication",
        "modeEnvironment": "ELMPAY_ARCHIVE_DETACH_MODE",
        "modeValue": "detach-authorized"
      },
      "fixedEnvironment": {
        "ELMPAY_ARCHIVE_DETACH_MODE": "detach-authorized",
        "ELMPAY_ARCHIVE_DETACH_DATABASE_USERNAME": "elmpay_partition_detacher",
        "ELMPAY_ARCHIVE_DETACH_DATABASE_PASSWORD_FILE": "/var/run/secrets/elmpay/archive-detacher-database-credentials/password",
        "ELMPAY_ARCHIVE_DETACH_DATABASE_CA_FILE": "/var/run/secrets/elmpay/archive-detacher-database-mtls/ca.crt",
