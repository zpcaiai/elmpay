{
  "schema_version": "1.0.0",
  "batch": "B33",
  "principle": "**每一次渠道调用都是一个新的、不可变的 attempt**，永远不复用上一条。把重试写回原来那一行，会抹掉「我们当时到底发了什么、什么时候发的」——而那正是事后唯一能回答「第一次调用到底有没有到渠道」的东西。由此派生的第一条也是本批次最重要的一条：**超时不是失败**。超时的结果是**未知**；把未知当成失败去重试，就是重复扣款的标准生成方式。另外两条：**未解决的未知会挡住下一次尝试**——必须先主动查询或对账把它落定；**只存请求摘要不存请求本身**——我们要能证明发了什么，但不能因此保留卡号。",
  "attempt": {
    "immutable": true,
    "one_per_provider_call": true,
    "reuse_on_retry_forbidden": true,
    "sequence_monotonic_per_intent": true,
    "required_fields": [
      "tenant_id",
      "intent_id",
      "provider",
      "sequence",
      "request_digest",
      "response_digest",
      "provider_request_id",
      "provider_transaction_id",
      "outcome_class",
      "provider_code_namespace",
      "provider_code",
      "started_at",
      "finished_at"
    ],
    "notes": "attempt 一旦写入终态就不可修改。重试开新的一条，序号单调递增——序号是事后重建时间线唯一可靠的东西，时间戳会因为时钟漂移骗人。"
  },
  "tenant_scope": {
    "tenant_id_required": true,
    "lookup_key": [
      "tenant_id",
      "intent_id"
    ],
    "external_ids_never_used_as_internal_ids": true,
    "notes": "所有查询、状态变化和去重都显式携带 tenant_id；同名 intent_id 在不同租户下互不相见。attempt_id 与渠道请求号独立生成，不把租户 ID、intent_id 或渠道 ID 拼成内部主键。"
  },
  "concurrency": {
    "atomic_start": true,
    "conflict_key": [
      "tenant_id",
      "intent_id"
    ],
    "concurrent_duplicate_policy": "reject_without_provider_call",
    "notes": "同一 tenant_id + intent_id 的并发 start 必须原子化：只有一个调用创建 attempt，其他调用在触达渠道前被拒绝。参考实现使用进程内锁；生产实现必须换成数据库唯一约束或等价的分布式原子机制。"
  },
  "reference_runtime": {
    "process_local_lock": true,
    "durable_storage": false,
    "database_unique_constraint": false,
    "runtime_audit_sink": false,
    "b32_replacement_confirmation_integrated": false,
    "production_ready": false,
    "notes": "当前 Python 代码只是不变量参考实现：并发保护仅覆盖单进程，记录不持久化，也没有把 attempt 事件写入 B23 审计存储。replacement_request 只建模 B33 attempt 规则，尚未接入 B32 Intents.confirm，也没有验证客户动作主体；因此不能声称更换资金源端到端可用、生产就绪或 B33 完成门已通过。"
  },
  "request_record": {
    "store_digest_not_payload": true,
    "digest_algorithm": "sha256",
    "redacted_fields": [
      "pan",
      "cvv",
      "credential",
      "token"
    ],
    "payload_replayable": false,
    "notes": "存摘要不存报文：我们需要证明「发出去的就是这一份」，但不需要为此把卡号留在库里。摘要也**不可用于重放**——一个能重放的请求记录就是一个能再扣一次钱的按钮。"
  },
  "response_record": {
    "store_summary_not_payload": true,
    "digest_algorithm": "sha256",
    "required_evidence_fields": [
      "provider_code",
      "provider_request_id",
      "provider_transaction_id",
      "outcome_class",
      "provider_code_namespace",
      "response_digest"
    ],
    "forbidden_fields": [
      "raw_response",
      "response_body",
      "headers",
      "authorization",
      "credential",
      "token",
      "pan",
      "cvv"
    ],
    "payload_replayable": false,
    "notes": "渠道响应只保留规范化的结果码、请求号、交易号、结果分类及其 SHA-256 摘要，不接收或保存原始响应体、响应头、凭证或令牌。这样既能重建渠道调用时间线，又不会把 attempt 表变成第二份敏感报文仓库。"
  },
  "outcome_classes": [
    {
      "id": "succeeded",
      "final": true,
      "settles_intent": true,
      "retry_allowed": false,
      "requires_resolution": false,
      "notes": "渠道明确成功。"
    },
    {
      "id": "failed_final",
      "final": true,
      "settles_intent": false,
      "retry_allowed": false,
      "requires_resolution": false,
      "notes": "渠道明确拒绝当前请求。**本次 attempt 终态且同一请求不可重试**，但它本身不把 PaymentIntent 永久落为失败；付款人更换资金源或重新授权后，可以用新的幂等键和新的 attempt 再试。"
    },
    {
      "id": "failed_retryable",
      "final": true,
      "settles_intent": false,
      "retry_allowed": true,
      "requires_resolution": false,
      "notes": "渠道明确表示「现在不行、稍后再来」（限流、临时不可用）。本次 attempt 已终结，但同一请求可按退避策略开新 attempt 并复用幂等键。"
    },
    {
      "id": "unknown",
      "final": false,
      "settles_intent": false,
      "retry_allowed": false,
      "requires_resolution": true,
      "notes": "**超时、连接中断、无法解析的响应全部落在这里**。未知不是失败：钱可能已经扣了。必须先查询或对账落定，才允许下一次尝试。"
    }
  ],
  "timeout": {
    "classified_as": "unknown",
    "retry_before_resolution_allowed": false,
    "resolution_methods": [
      "provider_query",
      "reconciliation_file"
    ],
    "max_resolution_hours": 24,
    "notes": "超时归类为未知，这条规则比它看起来重要得多：把超时当失败并立即重试，是支付系统里最常见的重复扣款成因。"
  },
  "retry": {
    "new_attempt_required": true,
    "reuse_idempotency_key": true,
    "only_for_retryable": true,
    "replacement_request_allowed_after": [
      "failed_final"
    ],
    "replacement_request_requires_new_idempotency_key": true,
    "replacement_request_requires_customer_action": true,
    "max_attempts_per_intent": 3,
    "backoff_seconds": [
      1,
      5,
      25
    ],
    "notes": "同一请求的传输/临时错误重试复用原幂等键，但必须开新 attempt。更换资金源或重新授权不是同一请求重试：它必须由明确的客户动作触发，并使用新的幂等键。两类路径不得混用。"
  },
  "error_taxonomy": [
    {
      "provider": "stripe",
      "code_namespace": "stripe.error.code",
      "provider_code": "card_declined",
      "outcome_class": "failed_final",
      "notes": "明确拒绝。"
    },
    {
      "provider": "stripe",
      "code_namespace": "stripe.error.code",
      "provider_code": "rate_limit",
      "outcome_class": "failed_retryable",
      "notes": "被限流：稍后重试会成功，因此归入可重试而不是失败。"
    },
    {
      "provider": "stripe",
      "code_namespace": "stripe.error.code",
      "provider_code": "processing_error",
      "outcome_class": "failed_retryable",
      "notes": "渠道内部临时错误。"
    },
    {
      "provider": "wechat",
      "code_namespace": "wechat.api_v3.code",
      "provider_code": "ORDERPAID",
      "outcome_class": "succeeded",
      "notes": "「订单已支付」是成功而不是错误——把它当错误会触发一次不必要的退款。"
    },
    {
      "provider": "wechat",
      "code_namespace": "wechat.api_v3.code",
      "provider_code": "SYSTEMERROR",
      "outcome_class": "unknown",
      "notes": "渠道明说结果未知，必须查询。"
    },
    {
      "provider": "alipay",
      "code_namespace": "alipay.sub_code",
      "provider_code": "ACQ.SYSTEM_ERROR",
      "outcome_class": "unknown",
      "notes": "支付宝系统异常，结果未知，必须主动查询后再决定。"
    },
    {
      "provider": "alipay",
      "code_namespace": "alipay.sub_code",
      "provider_code": "ACQ.BUYER_BALANCE_NOT_ENOUGH",
      "outcome_class": "failed_final",
      "notes": "余额不足，明确拒绝。"
    },
    {
      "provider": "paypal",
      "code_namespace": "paypal.details.issue",
      "provider_code": "INSTRUMENT_DECLINED",
      "outcome_class": "failed_final",
      "notes": "PayPal Orders v2 的 details.issue：当前资金源对应的请求已明确失败，不可原样自动重试；付款人选择其他资金源后，按 replacement request 使用新幂等键重试，因此不会永久落定 PaymentIntent。"
    },
    {
      "provider": "apple_pay",
      "code_namespace": "adapter.normalized",
      "provider_code": "DECRYPT_FAILED",
      "outcome_class": "failed_final",
      "notes": "elmpay Apple Pay/PSP 适配器归一化码，不声称是 Apple 官方错误码；令牌解密失败时同一令牌不可重试。"
    }
  ],
  "unmapped_code_class": "unknown",
  "finality": {
    "final_attempt_immutable": true,
    "intent_outcome_from_final_attempt": true,
    "failed_attempt_does_not_settle_intent": true,
    "contradicting_later_event_opens_reconciliation": true,
    "contradicting_later_event_overwrites": false,
    "notes": "终态 attempt 不可修改。只有明确标记 settles_intent 的 attempt 决定 PaymentIntent；当前分类中成功会落定意图，失败只结束该次请求。之后到达的矛盾渠道事件开对账项而不覆盖历史。"
  },
  "lifecycle": {
    "source": "governance/state-machines.json#payment-attempt",
    "states": [
      "initiated",
      "pending",
      "succeeded",
      "failed",
      "unknown"
    ],
    "initial": "initiated",
    "terminal": [
      "succeeded",
      "failed"
    ],
    "success_states": [
      "succeeded"
    ],
    "notes": "状态机在 B10 定义，此处引用。注意 `unknown` **不是终态**：它必须被落定。"
  },
  "audit_event_class": "money.movement"
}
