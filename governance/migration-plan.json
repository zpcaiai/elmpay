{
  "schema_version": "1.0.0",
  "batch": "B15",
  "principle": "业务订单留在原项目，只迁移支付事实与支付动作。平台永远不知道商品、库存与履约，这是 NN-01 在迁移期的具体形态。",
  "ownership": {
    "legacy_owns": [
      "business_order",
      "order_item",
      "sku",
      "inventory",
      "fulfilment",
      "shipping_address",
      "customer_profile",
      "promotion",
      "invoice_content"
    ],
    "platform_owns": [
      "payment_intent",
      "payment_attempt",
      "refund",
      "dispute",
      "subscription",
      "ledger_transaction",
      "ledger_entry",
      "recon_run",
      "recon_exception"
    ],
    "binding": {
      "field": "external_reference",
      "uniqueness": [
        "project_id",
        "external_reference"
      ],
      "policy": "平台与旧系统之间只通过 (project_id, external_reference) 绑定。平台不存业务订单号以外的任何订单信息，也不反向查询旧系统的库。"
    }
  },
  "legacy_database_access": {
    "allowed": false,
    "policy": "平台的任何服务都不得连接旧系统数据库（FF-01）。需要的业务上下文由适配层在调用时传入，且只限于绑定字段与金额。"
  },
  "adapter": {
    "owner": "legacy-project",
    "location": "旧系统内，不在平台仓库",
    "operations": [
      {
        "legacy_action": "创建支付",
        "platform_operation": "create_payment_intent",
        "idempotency_source": "external_reference",
        "passes_through": [
          "project_id",
          "external_reference",
          "amount_minor",
          "currency"
        ]
      },
      {
        "legacy_action": "捕获",
        "platform_operation": "capture_payment_intent",
        "idempotency_source": "external_reference",
        "passes_through": [
          "payment_intent_id"
        ]
      },
      {
        "legacy_action": "取消",
        "platform_operation": "cancel_payment_intent",
        "idempotency_source": "external_reference",
        "passes_through": [
          "payment_intent_id"
        ]
      },
      {
        "legacy_action": "退款",
        "platform_operation": "create_refund",
        "idempotency_source": "external_reference",
        "passes_through": [
          "payment_intent_id",
          "amount_minor",
          "currency"
        ]
      }
    ],
    "forbidden_passthrough": [
      "sku",
      "item",
      "quantity",
      "inventory",
      "stock",
      "shipping_address",
      "product_name",
      "coupon"
    ],
    "policy": "适配层住在旧系统里，由旧系统的团队拥有。把适配层放进平台仓库会让平台再次开始理解订单，那正是要避免的事。"
  },
  "dual_write": {
    "provider_calls_per_payment": 1,
    "divergence_detection": {
      "compare_fields": [
        "amount_minor",
        "currency",
        "status",
        "external_reference"
      ],
      "window_minutes": 15,
      "budget_pct": 0.1,
      "abort_rule": "分歧率超预算或出现任何金额类分歧时，立即停止推进并回退到上一期",
      "record_to": "recon_exception"
    },
    "policy": "双写是**双记录**，不是双扣款。任何一期里，一笔支付对渠道的调用只有一次；非权威侧写的是同一笔事实的镜像，它不持有幂等键，也不发起渠道请求。"
  },
  "backfill": {
    "source": "legacy 只读副本",
    "idempotent": true,
    "resumable": true,
    "checkpoint_field": "legacy_payment_id",
    "read_only_on_legacy": true,
    "verification": {
      "method": [
        "count_by_day",
        "sum_amount_minor_by_currency",
        "random_sample_1000"
      ],
      "tolerance": "零容差：任何一天的笔数或金额不一致即失败"
    },
    "policy": "回填必须可重跑、可断点续跑，且对旧系统只读。校验用总额而不是抽样——抽样能证明存在，证明不了守恒。"
  },
  "cutover": {
    "granularity": "project",
    "kill_switch": {
      "scope": "per_project",
      "max_activation_seconds": 60,
      "requires_audit_event": true
    },
    "policy": "按项目逐个切换，不做全局切换。kill switch 必须能在 60 秒内把一个项目切回上一期，并留下审计事件。"
  },
  "phases": [
    {
      "id": "P0",
      "name": "只读影子",
      "write_mode": "legacy_only",
      "authoritative_for_payment_facts": "legacy",
      "entry_criteria": [
        "平台已部署且可接收适配层调用",
        "已完成一个项目的字段映射评审"
      ],
      "exit_criteria": [
        "影子流量覆盖率 ≥ 95%",
        "连续 7 天零字段映射错误"
      ],
      "rollback": {
        "action": "关闭影子流量",
        "payment_facts_preserved": true,
        "reason": "影子期平台不发起任何渠道调用，关掉它不影响任何资金事实"
      },
      "evidence_gate": [
        "evidence/B15/runtime/migration-smoke.log"
      ],
      "notes": "平台只观察不动手：接收适配层的只读镜像调用，验证映射与状态推导，**绝不调用渠道**。这一期的唯一目的是证明映射是对的。"
    },
    {
      "id": "P1",
      "name": "双写·旧系统权威",
      "write_mode": "dual_write_legacy_authoritative",
      "authoritative_for_payment_facts": "legacy",
      "entry_criteria": [
        "P0 出口条件全部满足",
        "分歧检测已上线",
        "kill switch 已演练"
      ],
      "exit_criteria": [
        "分歧率 < 0.1% 且连续 14 天无资金类分歧",
        "对账连续 14 天平"
      ],
      "rollback": {
        "action": "回退到 legacy_only",
        "payment_facts_preserved": true,
        "reason": "平台侧记录保留为只读历史，不删除；旧系统始终是权威，回退无资金影响"
      },
      "evidence_gate": [
        "evidence/B15/runtime/dual-write-divergence.log"
      ],
      "notes": "双写指的是**双记录**，不是双扣款：渠道调用仍然只由旧系统发起一次，平台记录的是同一笔事实的镜像。这一点是本批次最重要的约束。"
    },
    {
      "id": "P2",
      "name": "双写·平台权威",
      "write_mode": "dual_write_platform_authoritative",
      "authoritative_for_payment_facts": "platform",
      "entry_criteria": [
        "P1 出口条件全部满足",
        "平台已通过独立审查",
        "回退演练成功"
      ],
      "exit_criteria": [
        "平台连续 30 天 SLO 达标",
        "分歧率 < 0.01%",
        "全部渠道已在平台侧完成真实交易"
      ],
      "rollback": {
        "action": "把权威切回 legacy 并保留平台记录",
        "payment_facts_preserved": true,
        "reason": "权威位是一个开关，不是一次数据迁移；两侧记录都完整，切回不丢事实"
      },
      "evidence_gate": [
        "evidence/B15/runtime/dual-write-divergence.log",
        "evidence/B15/security/governance-report.json"
      ],
      "notes": "权威切换后渠道调用由平台发起，旧系统转为镜像。切换粒度是**项目**，不是全局。"
    },
    {
      "id": "P3",
      "name": "平台单写",
      "write_mode": "platform_only",
      "authoritative_for_payment_facts": "platform",
      "entry_criteria": [
        "P2 出口条件全部满足",
        "旧系统侧支付代码已标记弃用且不再接收新项目"
      ],
      "exit_criteria": [
        "旧系统支付路径连续 90 天零流量",
        "历史数据回填校验通过"
      ],
      "rollback": {
        "action": "重新开启旧系统写入（需四眼复核）",
        "payment_facts_preserved": true,
        "reason": "旧系统代码保留但停用；重新启用是一个受控操作而不是重新部署"
      },
      "evidence_gate": [
        "evidence/B15/runtime/backfill-verification.log"
      ],
      "notes": "旧系统的支付代码**保留但停用**至少 90 天。删代码是最后一步，不是第一步。"
    }
  ]
}
