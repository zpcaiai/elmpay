{
  "schema_version": "1.0.0",
  "batch": "B22",
  "principle": "一条没有被任何规则或测试执行的安全要求，等于一句话。所以这里不是一张对照表，而是一份**可执行的映射**：每一条要求要么指向一个真实存在、真实会触发的门禁规则码，要么指向一个真实存在的测试方法，要么被**明确记为缺口**（带负责人和复核批次）。门禁会去核对这三件事——引用一个不存在的规则码，本身就是一条不合格。",
  "standards": [
    {
      "id": "ASVS",
      "version": "4.0.3",
      "notes": "OWASP 应用安全验证标准，本平台按 L2 要求。"
    },
    {
      "id": "API",
      "version": "2023",
      "notes": "OWASP API Security Top 10。"
    },
    {
      "id": "MASVS",
      "version": "2.0",
      "notes": "OWASP 移动应用安全验证标准；本平台目前没有自有移动端，相关条目一律记为缺口而不是「符合」。"
    }
  ],
  "coverage_policy": {
    "minimum_covered_ratio": 0.75,
    "max_accepted_gaps": 8,
    "gap_requires_owner": true,
    "gap_requires_review_batch": true,
    "notes": "覆盖率的分母是**适用的**要求；不适用的条目不能靠改 applicability 来提高分子。缺口有上限，因为「记为缺口」如果没有上限，它就是「忽略」的另一个写法。"
  },
  "requirements": [
    {
      "id": "ASVS-1.4.1",
      "standard": "ASVS",
      "title": "访问控制在可信服务层强制执行，不依赖客户端",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "AUTHZ_DEFAULT_DECISION",
          "AUTHZ_ROLE_PERMISSION_UNKNOWN"
        ]
      },
      "notes": "默认拒绝 + 权限必须显式授予，由 B19 的授权模型强制。"
    },
    {
      "id": "ASVS-1.4.4",
      "standard": "ASVS",
      "title": "同一套访问控制机制贯穿全应用",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b19_authz.py::AuthzDecisionFunction::test_the_maker_cannot_be_the_checker"
        ]
      },
      "notes": "唯一的判定函数，四层判定顺序固定。"
    },
    {
      "id": "ASVS-2.2.1",
      "standard": "ASVS",
      "title": "对认证器实施抗自动化攻击控制",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "MFA_PUSH_FATIGUE",
          "MFA_RATE_LIMIT"
        ]
      },
      "notes": "限流与防推送疲劳由 B18 强制。"
    },
    {
      "id": "ASVS-2.5.4",
      "standard": "ASVS",
      "title": "账号恢复不得降低认证强度",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "ID_RECOVERY_DOWNGRADE",
          "MFA_RECOVERY_BYPASS"
        ]
      },
      "notes": "恢复路径是账号接管最常用的入口。"
    },
    {
      "id": "ASVS-2.8.1",
      "standard": "ASVS",
      "title": "高权限操作使用抗钓鱼认证器",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "MFA_WEAK_FOR_PRIVILEGED",
          "AUTHZ_ROLE_NO_MFA"
        ]
      },
      "notes": "特权角色清单由 B19 统一，MFA 要求由 B18 强制。"
    },
    {
      "id": "ASVS-3.3.1",
      "standard": "ASVS",
      "title": "会话在登出与超时后失效",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "ZT_SESSION",
          "ID_REVOCATION_CHECK"
        ]
      },
      "notes": "每次请求检查撤销，人类会话有上限。"
    },
    {
      "id": "ASVS-3.5.3",
      "standard": "ASVS",
      "title": "使用不透明或已签名的会话令牌，且绑定持有者",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "ID_BEARER_TOKEN",
          "ID_BINDING_METHOD"
        ]
      },
      "notes": "不存在无绑定的 bearer 令牌。"
    },
    {
      "id": "ASVS-4.1.3",
      "standard": "ASVS",
      "title": "最小权限原则",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "AUTHZ_STANDING_ELEVATED",
          "AUTHZ_STANDING_PRIVILEGE"
        ]
      },
      "notes": "不存在常驻特权，高危权限只能限时提权获得。"
    },
    {
      "id": "ASVS-4.2.2",
      "standard": "ASVS",
      "title": "状态改变操作有反自动化/反 CSRF 控制",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "ID_CSRF",
          "API_MUTATION_NOT_IDEMPOTENT"
        ]
      },
      "notes": "state/nonce 必需；写操作必须幂等。"
    },
    {
      "id": "ASVS-5.1.3",
      "standard": "ASVS",
      "title": "所有输入在服务端校验",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b22_baseline.py::HardeningReference::test_amount_parsing_rejects_floats_and_junk"
        ]
      },
      "notes": "金额解析拒绝浮点、指数、空白与超限值。"
    },
    {
      "id": "ASVS-5.3.4",
      "standard": "ASVS",
      "title": "输出编码/参数化查询防止注入",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "accepted_gap",
        "refs": [],
        "owner": "platform-security",
        "review_batch": "B40"
      },
      "notes": "本仓目前没有查询层实现，参数化查询属于实现批次。"
    },
    {
      "id": "ASVS-6.2.1",
      "standard": "ASVS",
      "title": "使用经过审计的密码学实现，不自行实现算法",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "accepted_gap",
        "refs": [],
        "owner": "platform-security",
        "review_batch": "B40"
      },
      "notes": "参考实现刻意使用非真实密码学（B20 §8 已声明），真实实现必须替换为经审计的 AEAD 库。"
    },
    {
      "id": "ASVS-6.4.1",
      "standard": "ASVS",
      "title": "密钥由密钥管理方案保管，不硬编码",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "KEY_HARDCODED",
          "KEY_APP_HOLDS_MATERIAL",
          "CONFIG_LITERAL_SECRET"
        ]
      },
      "notes": "禁止硬编码密钥材料，应用不持有密钥。"
    },
    {
      "id": "ASVS-6.4.2",
      "standard": "ASVS",
      "title": "密钥有轮换与销毁流程",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "KEY_ROTATION_MISSING",
          "CERT_NO_OVERLAP",
          "KEY_NO_SHREDDING"
        ]
      },
      "notes": "轮换有重叠期，销毁是密码学销毁。"
    },
    {
      "id": "ASVS-7.1.1",
      "standard": "ASVS",
      "title": "日志不含凭证与支付敏感数据",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "KEY_IN_LOGS",
          "API_ERROR_LEAK"
        ]
      },
      "notes": "另有运行期脱敏函数（见 ASVS-7.1.2）。"
    },
    {
      "id": "ASVS-7.1.2",
      "standard": "ASVS",
      "title": "日志与错误信息脱敏",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b22_baseline.py::HardeningReference::test_redaction_strips_card_numbers_and_credentials"
        ]
      },
      "notes": "把一段真实的异常堆栈交给脱敏函数，卡号与密钥都不应出现在输出里。"
    },
    {
      "id": "ASVS-8.3.4",
      "standard": "ASVS",
      "title": "敏感数据在存储中加密",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
