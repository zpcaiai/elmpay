    },
    {
      "id": "API-10",
      "standard": "API",
      "title": "不安全地消费第三方 API",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "TOPO_FAIL_OPEN",
