          "AUTHZ_FIELD_CLASSIFICATION"
        ]
      },
      "notes": "B19 分类为敏感的字段必须有数据密钥保护。"
    },
    {
      "id": "ASVS-9.1.1",
      "standard": "ASVS",
      "title": "通信使用 TLS，且内部通信也加密",
      "level": "L2",
      "applicability": "backend",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "ZT_BOUNDARY_REQUIREMENTS",
          "CERT_SELF_SIGNED_EDGE"
        ]
      },
      "notes": "内部区域间的访问要求包含 mutual TLS（B16 的 zone_rules），边缘禁止自签证书。"
    },
    {
      "id": "ASVS-10.3.2",
      "standard": "ASVS",
      "title": "部署物完整性可验证",
      "level": "L2",
      "applicability": "supply_chain",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
