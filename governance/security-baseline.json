      "notes": "CI 有必需阶段，工具链依赖按摘要固定（不是浮动版本）。"
    },
    {
      "id": "ASVS-12.1.1",
      "standard": "ASVS",
      "title": "限制上传大小/资源消耗",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "accepted_gap",
        "refs": [],
        "owner": "platform-security",
        "review_batch": "B40"
      },
      "notes": "没有实现层，属于 B4x API 实现批次。"
    },
    {
      "id": "ASVS-13.2.1",
      "standard": "ASVS",
      "title": "API 使用与操作语义一致的方法与状态码",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
          "API_ERROR_STATUS",
          "API_PATH"
        ]
      },
      "notes": "由 B11 的 API 契约强制。"
    },
    {
      "id": "ASVS-14.4.1",
      "standard": "ASVS",
      "title": "响应带安全响应头",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b22_baseline.py::HardeningReference::test_missing_security_headers_are_reported"
        ]
      },
      "notes": "HSTS、CSP、nosniff、frame-ancestors 缺一即报。"
    },
    {
      "id": "ASVS-14.5.2",
      "standard": "ASVS",
      "title": "CORS 不使用通配符配合凭据",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b22_baseline.py::HardeningReference::test_wildcard_cors_with_credentials_is_rejected"
        ]
      },
      "notes": "`Access-Control-Allow-Origin: *` 与 `Allow-Credentials: true` 同时出现是明确错误。"
    },
    {
      "id": "API-01",
      "standard": "API",
      "title": "失效的对象级授权（BOLA）",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "test",
        "refs": [
          "tools/tests/test_b19_authz.py::AuthzDecisionFunction::test_object_ownership_is_checked_even_inside_the_right_tenant"
        ]
      },
      "notes": "对象归属在租户判定之后仍要单独判定。"
    },
    {
      "id": "API-02",
      "standard": "API",
      "title": "失效的身份认证",
      "level": "L2",
      "applicability": "api",
      "enforcement": {
        "kind": "gate_rule",
        "refs": [
