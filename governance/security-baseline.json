    {
      "id": "MASVS-AUTH-2",
      "standard": "MASVS",
      "title": "移动端本地认证不可被绕过",
      "level": "L2",
      "applicability": "mobile",
      "enforcement": {
        "kind": "accepted_gap",
        "refs": [],
