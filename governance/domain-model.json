        {
          "name": "updated_at",
          "type": "timestamp",
          "nullable": false,
          "semantics": ""
        }
      ],
      "invariants": [
        "code 创建后不可变",
        "suspended 租户不得创建新的 PaymentIntent",
        "closed 租户只允许只读查询与对账"
