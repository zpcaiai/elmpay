{
  "schema_version": "1.0.0",
  "batch": "B13",
  "tenancy": {
    "model": "shared_database_shared_schema_with_rls",
    "tenant_column": "tenant_id",
    "session_setting": "app.tenant_id",
    "policy": "共享库共享表 + 强制行级安全。应用连接使用非 owner 角色，且 owner 角色也必须 FORCE ROW LEVEL SECURITY——否则一次以 owner 身份跑的运维脚本就能跨租户读全表。",
    "escape_hatch": {
      "role": "platform_break_glass",
      "requires_audit_event": true,
      "requires_second_approver": true,
      "max_session_minutes": 60,
      "policy": "跨租户访问必须走单独角色，留审计事件并且四眼复核（NN-11）。没有紧急通道的隔离设计会在第一次故障时被人用 superuser 绕过。"
    }
  },
  "mutability_kinds": [
    "mutable",
    "append_only"
  ],
  "partition_kinds": [
    "none",
    "range",
    "hash"
  ],
  "deletion_strategies": [
    "crypto_shred",
    "hard_delete",
    "anonymise"
  ],
  "archive": {
    "target_scheme": "object-storage",
    "format": "parquet",
    "integrity": "sha256_manifest",
    "policy": "归档必须可校验、可回读。写出去就再也读不回来的归档等于删除。"
  },
  "sharding": {
    "status": "planned",
    "key": "tenant_id",
    "policy": "现在不分片，但每张租户表的主键与索引都以 tenant_id 打头，使将来按租户分片成为搬迁而不是重写。"
  },
  "tables": [
