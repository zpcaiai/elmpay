{
  "schema_version": "1.0.0",
  "batch": "B05",
  "runner": "ubuntu-24.04",
  "triggers": {
    "push": [
      "main"
    ],
    "pull_request": [
      "main"
    ],
    "workflow_dispatch": true
  },
  "permissions": {
    "contents": "read",
    "id-token": "none",
    "packages": "none",
    "actions": "none"
  },
  "signing_policy": {
    "trusted_event": "push",
    "trusted_repository": "zpcaiai/elmpay",
    "trusted_ref": "refs/heads/main",
    "trusted_workflow": ".github/workflows/ci.yml",
    "public_sigstore_opt_in_variable": "ELMPAY_PUBLIC_SIGSTORE_METADATA_DISCLOSURE_OPT_IN",
    "cosign_release": "v3.0.6",
    "oidc_issuer": "https://token.actions.githubusercontent.com",
    "slsa_build_level": 1,
    "predicate_type": "https://slsa.dev/provenance/v1",
    "build_type": "https://slsa-framework.github.io/github-actions-buildtypes/workflow/v1",
    "validation_only_skipped_stages": [
      "sign",
      "evidence-archive"
    ],
    "validation_only_outcome": "validated-not-release-eligible",
    "artifact_project_source": "governance/version-catalog.json#modules_by_build_system.gradle",
    "artifact_manifest": "build/signing-inputs/artifact-manifest.json",
    "artifact_manifest_sha256": "build/signing-inputs/artifact-manifest.sha256",
    "job_permissions": {
      "actions": "none",
      "contents": "read",
      "id-token": "write",
      "packages": "none"
    },
    "downloads": [
      {
        "name": "build-artifacts",
        "path": "build/signing-inputs"
      },
      {
        "name": "sbom-artifacts",
        "path": "build/reports"
      }
    ]
  },
  "required_stages": [
    "governance",
    "build",
    "unit-test",
    "static-analysis",
    "secret-scan",
    "dependency-scan",
    "container-scan",
    "iac-scan",
    "sbom",
    "sign",
    "negative-controls",
    "evidence-archive",
    "rule-knockout"
  ],
  "actions": [
    {
      "name": "actions/checkout",
      "ref": "08c6903cd8c0fde910a37f88322edcfb5dd907a8",
      "version_comment": "v5.0.0"
    },
    {
      "name": "actions/setup-java",
      "ref": "c5195efecf7bdfc987ee8bae7a71cb8b11521c00",
      "version_comment": "v5.0.0"
    },
    {
      "name": "actions/upload-artifact",
      "ref": "ea165f8d65b6e75b540449e92b4886f43607fa02",
      "version_comment": "v4.6.2"
    },
    {
      "name": "actions/download-artifact",
      "ref": "3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
      "version_comment": "v8.0.1"
    },
    {
      "name": "sigstore/cosign-installer",
      "ref": "6f9f17788090df1f26f669e9d70d6ae9567deba6",
      "version_comment": "v4.1.2"
    },
    {
      "name": "gradle/actions/setup-gradle",
      "ref": "06832c7b30a0129d7fb559bcc6e43d26f6374244",
      "version_comment": "v4.3.1"
    }
  ],
  "quality_gates": {
    "unit_test_failed_max": 0,
    "skipped_critical_max": 0,
    "blocking_security_findings_max": 0,
    "governance_problems_max": 0,
    "line_coverage_min_percent": 80,
    "mutation_score_min_percent": 60
  },
  "blocking_conditions": [
    {
      "id": "BLOCK-01",
      "description": "存在未接受的阻断级安全问题",
      "detected_by": [
        "static-analysis",
        "dependency-scan",
        "container-scan",
        "iac-scan",
        "secret-scan"
      ],
      "gate": "RG4"
    },
    {
      "id": "BLOCK-02",
      "description": "账本借贷不平或存在不可解释的资金差异",
      "detected_by": [
        "unit-test"
      ],
      "gate": "RG2"
    },
    {
      "id": "BLOCK-03",
      "description": "备份、回滚或灾难恢复路径不可用",
      "detected_by": [
        "evidence-archive"
      ],
      "gate": "RG5"
    },
    {
      "id": "BLOCK-04",
      "description": "关键证据缺失、追踪断链或依赖哈希不一致",
      "detected_by": [
        "evidence-archive",
        "governance",
        "rule-knockout"
      ],
      "gate": "RG1"
    },
    {
      "id": "BLOCK-05",
      "description": "关键测试被跳过或测试摘要不干净",
      "detected_by": [
        "unit-test"
      ],
      "gate": "RG2"
    },
    {
      "id": "BLOCK-06",
      "description": "制品未签名或缺少来源证明",
      "detected_by": [
        "sign"
      ],
      "gate": "RG4"
    }
  ],
  "stages": [
    {
      "id": "governance",
      "name": "治理门禁",
      "purpose": "校验技能包镜像、章程、红线、模块边界、需求、威胁模型、工具链与本地平台声明",
      "needs": [],
      "commands": [
        "python3 .payment-platform/skill-package/scripts/verify_package.py",
        "diff -qr .payment-platform/skill-package/skills .agents/skills",
        "diff -qr .payment-platform/skill-package/skills .claude/skills",
        "python3 -m tools.paygov.cli verify-all --repo . --out governance-report.json",
        "python3 scripts/render-docs.py --check",
        "python3 scripts/render-build.py --check",
        "python3 scripts/render-dev-platform.py --check",
        "python3 scripts/batch.py crosscheck"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "governance-report.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "unit-test",
      "name": "单元与属性测试",
      "purpose": "编译并运行全部单元、属性与并发测试，禁止跳过关键测试",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/test-summary.py --out build/test-summary.json --log build/unittest.log",
        "./gradlew --no-daemon test"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG2",
      "artifacts": [
        "build/test-summary.json",
        "build/unittest.log"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 30
    },
    {
      "id": "build",
      "name": "编译与制品构建",
      "purpose": "以固定工具链构建声明的 Gradle leaf，并生成待签名制品 manifest",
      "needs": [
        "governance"
      ],
      "commands": [
        "./gradlew --no-daemon --console=plain build -x test",
        "scripts/stage-signing-artifacts.sh"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/signing-inputs/"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 30
    },
    {
      "id": "static-analysis",
      "name": "构建检查与模块边界验证",
      "purpose": "执行 Gradle check、编译告警即错误与模块边界治理；当前不宣称生产源码 SAST",
      "needs": [
        "build"
      ],
      "commands": [
        "./gradlew --no-daemon check -x test",
        "python3 -m tools.paygov.cli verify module-registry --repo . --out build/static-analysis.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/static-analysis.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "secret-scan",
      "name": "仓库凭证模式与卫生治理",
      "purpose": "扫描已跟踪源码与配置中的凭证模式和仓库卫生；不宣称 Git 历史或构建制品扫描",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify repo-hygiene --repo . --out secret-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "secret-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "dependency-scan",
      "name": "依赖漏洞聚合扫描",
      "purpose": "对全部 Gradle 项目执行已知漏洞聚合检查；数据源、分析或报告错误即失败",
      "needs": [
        "build"
      ],
      "commands": [
        "./gradlew --no-daemon dependencyCheckAggregate"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/reports/dependency-check-report.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 25
    },
    {
      "id": "container-scan",
      "name": "容器工具链与本地平台治理",
      "purpose": "验证镜像摘要声明和本地平台配置；当前没有 OCI 产品镜像，因而不宣称镜像漏洞扫描",
      "needs": [
        "build"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify toolchain dev-platform --repo . --out container-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "container-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "iac-scan",
      "name": "本地平台配置治理",
      "purpose": "验证 compose、本地模拟器、数据边界和摘要固定声明；不宣称生产 Kubernetes/Terraform 扫描",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify dev-platform --repo . --out iac-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "iac-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "sbom",
      "name": "SBOM 生成",
      "purpose": "生成覆盖声明 Gradle 项目的聚合 CycloneDX JSON；不把聚合 BOM 冒充逐制品 SBOM",
      "needs": [
        "build"
      ],
      "commands": [
        "./gradlew --no-daemon cyclonedxBom"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/reports/bom.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "sign",
      "name": "制品签名与来源证明",
      "purpose": "按校验后的全制品 manifest 对 JAR、manifest 与 SBOM 文件执行无密钥 blob 签名并生成 SLSA Build L1 provenance",
      "needs": [
        "build",
        "sbom",
        "unit-test",
        "static-analysis",
        "dependency-scan",
        "container-scan",
        "iac-scan",
        "secret-scan",
        "negative-controls",
        "rule-knockout"
      ],
      "commands": [
        "scripts/sign-artifacts.sh"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/provenance.intoto.jsonl",
        "build/signatures/"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "negative-controls",
      "name": "运行期 fail-closed 验证",
      "purpose": "以真实 CLI 对被破坏的治理面验证门禁确实会失败",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/negative-controls.py > negative-controls.log 2>&1"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "negative-controls.log"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "evidence-archive",
      "name": "证据归档",
      "purpose": "交叉校验两套编排实现和逐批完成证据，并生成受 GitHub retention 约束的仓库证据 tarball；任一批次不通过则拒绝出包",
      "needs": [
        "sign",
        "negative-controls",
        "rule-knockout"
      ],
      "commands": [
        "python3 scripts/batch.py crosscheck",
        "python3 scripts/validate-all.py",
        "python3 scripts/archive-evidence.py --out build/evidence-bundle.tar.gz"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/evidence-bundle.tar.gz"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "rule-knockout",
      "name": "规则承重验证",
      "purpose": "逐条抑制校验规则并重跑其覆盖测试，测试仍通过即说明该规则不承重",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/rule-knockout.py --out build/rule-knockout.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/rule-knockout.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    }
  ]
}
