{
  "schema_version": "1.0.0",
  "batch": "B05",
  "runner": "ubuntu-24.04",
  "triggers": {
    "push": [
      "main"
    ],
    "pull_request": [
      "main"
    ],
    "workflow_dispatch": true
  },
  "permissions": {
    "contents": "read",
    "id-token": "none",
    "packages": "none",
    "actions": "none"
  },
  "gradle_cache_policy": {
    "writer_stage": "build",
    "trusted_event": "push",
    "trusted_repository": "zpcaiai/elmpay",
    "trusted_ref": "refs/heads/main",
    "all_other_stages_read_only": true,
    "dependency_data_stage": "dependency-scan",
    "dependency_data_cache_path": "~/.gradle/dependency-check-data/11.0",
    "dependency_data_cache_key": "dependency-check-13.0.0-data-11.0-${{ runner.os }}-${{ runner.arch }}-${{ github.run_id }}-${{ github.run_attempt }}",
    "dependency_data_restore_key": "dependency-check-13.0.0-data-11.0-${{ runner.os }}-${{ runner.arch }}-",
    "dependency_data_restore_action": "actions/cache/restore",
    "dependency_data_save_action": "actions/cache/save"
  },
  "signing_policy": {
    "trusted_event": "push",
    "trusted_repository": "zpcaiai/elmpay",
    "trusted_ref": "refs/heads/main",
    "trusted_workflow": ".github/workflows/ci.yml",
    "public_sigstore_opt_in_variable": "ELMPAY_PUBLIC_SIGSTORE_METADATA_DISCLOSURE_OPT_IN",
    "cosign_release": "v3.0.6",
    "oidc_issuer": "https://token.actions.githubusercontent.com",
    "slsa_build_level": 1,
    "predicate_type": "https://slsa.dev/provenance/v1",
    "build_type": "https://slsa-framework.github.io/github-actions-buildtypes/workflow/v1",
    "validation_only_skipped_stages": [
      "sign",
      "evidence-archive"
    ],
    "validation_only_outcome": "validated-not-release-eligible",
    "artifact_project_source": "governance/version-catalog.json#modules_by_build_system.gradle",
    "artifact_manifest": "build/signing-inputs/artifact-manifest.json",
    "artifact_manifest_sha256": "build/signing-inputs/artifact-manifest.sha256",
    "job_permissions": {
      "actions": "none",
      "contents": "read",
      "id-token": "write",
      "packages": "none"
    },
    "downloads": [
      {
        "name": "build-artifacts",
        "path": "build/signing-inputs"
      },
      {
        "name": "sbom-artifacts",
        "path": "build/reports"
      }
    ]
  },
  "required_stages": [
    "governance",
    "python-floor",
    "build",
    "unit-test",
    "ios-sdk-test",
    "flutter-sdk-test",
    "quality-metrics",
    "static-analysis",
    "secret-scan",
    "dependency-scan",
    "container-scan",
    "iac-scan",
    "sbom",
    "sign",
    "negative-controls",
    "evidence-archive",
    "rule-knockout"
  ],
  "actions": [
    {
      "name": "actions/checkout",
      "ref": "08c6903cd8c0fde910a37f88322edcfb5dd907a8",
      "version_comment": "v5.0.0"
    },
    {
      "name": "actions/setup-java",
      "ref": "b6effb05e454b25005698d916606bdc6ffcbf961",
      "version_comment": "v5.7.0"
    },
    {
      "name": "actions/setup-python",
      "ref": "5fda3b95a4ea91299a34e894583c3862153e4b97",
      "version_comment": "v7.0.0"
    },
    {
      "name": "actions/setup-node",
      "ref": "249970729cb0ef3589644e2896645e5dc5ba9c38",
      "version_comment": "v6.5.0"
    },
    {
      "name": "dart-lang/setup-dart",
      "ref": "7654d458321ee25acccccfdb86cd48bd95768ff1",
      "version_comment": "v1.8.0"
    },
    {
      "name": "actions/setup-go",
      "ref": "4dc6199c7b1a012772edbd06daecab0f50c9053c",
      "version_comment": "v6.1.0"
    },
    {
      "name": "actions/setup-dotnet",
      "ref": "baa11fbfe1d6520db94683bd5c7a3818018e4309",
      "version_comment": "v5.1.0"
    },
    {
      "name": "actions/cache/restore",
      "ref": "27d5ce7f107fe9357f9df03efb73ab90386fccae",
      "version_comment": "v5.0.5"
    },
    {
      "name": "actions/cache/save",
      "ref": "27d5ce7f107fe9357f9df03efb73ab90386fccae",
      "version_comment": "v5.0.5"
    },
    {
      "name": "actions/upload-artifact",
      "ref": "b7c566a772e6b6bfb58ed0dc250532a479d7789f",
      "version_comment": "v6.0.0"
    },
    {
      "name": "actions/download-artifact",
      "ref": "3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
      "version_comment": "v8.0.1"
    },
    {
      "name": "sigstore/cosign-installer",
      "ref": "6f9f17788090df1f26f669e9d70d6ae9567deba6",
      "version_comment": "v4.1.2"
    },
    {
      "name": "gradle/actions/setup-gradle",
      "ref": "0723195856401067f7a2779048b490ace7a47d7c",
      "version_comment": "v5.0.2"
    },
    {
      "name": "github/codeql-action/init",
      "ref": "9b3254085494b55a0f7c4c2b3d2d52cc712ce370",
      "version_comment": "v4.39.1"
    },
    {
      "name": "github/codeql-action/analyze",
      "ref": "9b3254085494b55a0f7c4c2b3d2d52cc712ce370",
      "version_comment": "v4.39.1"
    }
  ],
  "quality_gates": {
    "unit_test_failed_max": 0,
    "skipped_critical_max": 0,
    "blocking_security_findings_max": 0,
    "governance_problems_max": 0,
    "line_coverage_min_percent": 80,
    "mutation_score_min_percent": 60
  },
  "blocking_conditions": [
    {
      "id": "BLOCK-01",
      "description": "存在未接受的阻断级安全问题",
      "detected_by": [
        "static-analysis",
        "dependency-scan",
        "container-scan",
        "iac-scan",
        "secret-scan"
      ],
      "gate": "RG4"
    },
    {
      "id": "BLOCK-02",
      "description": "账本借贷不平或存在不可解释的资金差异",
      "detected_by": [
        "unit-test",
        "ios-sdk-test",
        "flutter-sdk-test"
      ],
      "gate": "RG2"
    },
    {
      "id": "BLOCK-03",
      "description": "备份、回滚或灾难恢复路径不可用",
      "detected_by": [
        "evidence-archive"
      ],
      "gate": "RG5"
    },
    {
      "id": "BLOCK-04",
      "description": "关键证据缺失、追踪断链或依赖哈希不一致",
      "detected_by": [
        "evidence-archive",
        "governance",
        "rule-knockout"
      ],
      "gate": "RG1"
    },
    {
      "id": "BLOCK-05",
      "description": "关键测试被跳过或测试摘要不干净",
      "detected_by": [
        "unit-test",
        "quality-metrics"
      ],
      "gate": "RG2"
    },
    {
      "id": "BLOCK-06",
      "description": "制品未签名或缺少来源证明",
      "detected_by": [
        "sign"
      ],
      "gate": "RG4"
    }
  ],
  "stages": [
    {
      "id": "governance",
      "name": "治理门禁",
      "purpose": "校验技能包镜像、章程、红线、模块边界、需求、威胁模型、工具链与本地平台声明",
      "needs": [],
      "commands": [
        "python3 .payment-platform/skill-package/scripts/verify_package.py",
        "diff -qr .payment-platform/skill-package/skills .agents/skills",
        "diff -qr .payment-platform/skill-package/skills .claude/skills",
        "python3 -m tools.paygov.cli verify-all --repo . --out governance-report.json",
        "python3 scripts/render-docs.py --check",
        "python3 scripts/render-build.py --check",
        "python3 scripts/render-dev-platform.py --check",
        "python3 scripts/batch.py crosscheck"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "governance-report.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "python-floor",
      "name": "Python 兼容地板门禁",
      "purpose": "在精确固定的最旧受支持 Python 上执行完整治理校验，阻断语法、标准库与裁决行为漂移",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify-all --repo . --out python-floor-report.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "python-floor-report.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "unit-test",
      "name": "单元与属性测试",
      "purpose": "运行 tools/tests、testing 产品面、128 批次本地矩阵、渠道矩阵、checkout/admin Web、server SDK 与含 Android 的根 Gradle 测试，禁止跳过关键测试",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/test-summary.py --suite-root tools/tests --out build/test-summary.json --log build/unittest.log",
        "mkdir -p build/test-surfaces && python3 -m unittest discover -s testing -p 'test_*.py' -v > build/test-surfaces/testing.log 2>&1",
        "python3 scripts/provider-contract-matrix.py > build/test-surfaces/provider-contract-matrix.log 2>&1",
        "node --test apps/checkout-web/test/*.test.mjs > build/test-surfaces/checkout-web.log 2>&1",
        "node --test apps/admin-web/test/*.test.mjs > build/test-surfaces/admin-web.log 2>&1",
        "python3 scripts/sdk-contract-smoke.py > build/test-surfaces/server-sdk.log 2>&1",
        "./gradlew --no-daemon test > build/test-surfaces/gradle.log 2>&1",
        "python3 scripts/run-test-matrix.py --execution local --json-out build/test-matrix/local-report.json --junit-out build/test-matrix/local-junit.xml > build/test-surfaces/test-matrix-local.log 2>&1"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG2",
      "artifacts": [
        "build/test-summary.json",
        "build/unittest.log",
        "build/test-surfaces/",
        "build/test-matrix/"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 60
    },
    {
      "id": "ios-sdk-test",
      "name": "iOS SDK 托管平台契约测试",
      "purpose": "在 macOS hosted runner 上运行 Swift 6 package contract tests；错误主机、缺工具或版本不符明确 BLOCKED 并失败",
      "runner": "macos-15",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/platform_sdk_test.py ios --out build/mobile-sdk/ios.json --log build/mobile-sdk/ios.log"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG2",
      "artifacts": [
        "build/mobile-sdk/ios.json",
        "build/mobile-sdk/ios.log"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "flutter-sdk-test",
      "name": "Flutter/Dart SDK 托管平台契约测试",
      "purpose": "使用固定 Dart SDK 与 lockfile 运行 Flutter-compatible client contract tests；缺工具或版本不符明确 BLOCKED 并失败",
      "runner": "ubuntu-24.04",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/platform_sdk_test.py flutter --out build/mobile-sdk/flutter.json --log build/mobile-sdk/flutter.log"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG2",
      "artifacts": [
        "build/mobile-sdk/flutter.json",
        "build/mobile-sdk/flutter.log"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "quality-metrics",
      "name": "真实覆盖率与变异门禁",
      "purpose": "执行 Coverage.py、JaCoCo 与 PIT 的完整受治理范围，强制行覆盖率至少 80% 且 mutation score 至少 60%；缺工具或缺新鲜 XML 明确阻塞",
      "needs": [
        "unit-test"
      ],
      "commands": [
        "python3 -m pip install --disable-pip-version-check --no-input --only-binary=:all: 'coverage==7.14.3'",
        "python3 tools/quality_gate.py coverage-mutation"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG2",
      "artifacts": [
        "build/quality-metrics/",
        "**/build/reports/jacoco/test/jacocoTestReport.xml",
        "**/build/reports/pitest/mutations.xml"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 120
    },
    {
      "id": "build",
      "name": "编译与制品构建",
      "purpose": "以固定工具链构建声明的 Gradle leaf，并生成待签名制品 manifest",
      "needs": [
        "governance"
      ],
      "commands": [
        "./gradlew --no-daemon --console=plain build -x test",
        "scripts/stage-signing-artifacts.sh"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/signing-inputs/"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 30
    },
    {
      "id": "static-analysis",
      "name": "CodeQL 源码扫描、构建检查与真实沙箱 DAST",
      "purpose": "执行 CodeQL security-extended、编译检查与真实沙箱 DAST；告警即阻断，未验收时不宣称生产源码 SAST 已通过",
      "needs": [
        "build"
      ],
      "commands": [
        "./gradlew --no-daemon check -x test --no-build-cache --rerun-tasks",
        "python3 -m tools.paygov.cli verify module-registry --repo . --out build/static-analysis.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/static-analysis.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "secret-scan",
      "name": "仓库凭证模式与卫生治理",
      "purpose": "扫描已跟踪源码与配置中的凭证模式和仓库卫生；不宣称 Git 历史或构建制品扫描",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify repo-hygiene --repo . --out secret-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "secret-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "dependency-scan",
      "name": "依赖漏洞聚合扫描",
      "purpose": "对全部 Gradle 项目执行已知漏洞聚合检查；数据源、分析或报告错误即失败",
      "needs": [
        "build"
      ],
      "commands": [
        "python3 -m tools.paygov.nvdfeed --repo .",
        "./gradlew --no-daemon dependencyCheckAggregate"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/reports/dependency-check-report.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 45
    },
    {
      "id": "container-scan",
      "name": "产品 OCI 源契约与外部扫描门禁",
      "purpose": "验证六个产品 OCI 构建、运行布局和准入源契约；真实镜像构建、逐镜像 SBOM、扫描、注册表签名必须以 exact release index 进入终态门禁，未执行不宣称通过",
      "needs": [
        "build"
      ],
      "commands": [
        "python3 scripts/product-image-pipeline.py source-gate",
        "python3 -m tools.paygov.cli verify toolchain dev-platform --repo . --out container-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "container-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    },
    {
      "id": "iac-scan",
      "name": "本地平台配置治理",
      "purpose": "验证 compose、本地模拟器、数据边界和摘要固定声明；不宣称生产 Kubernetes/Terraform 扫描",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 -m tools.paygov.cli verify dev-platform --repo . --out iac-scan.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "iac-scan.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "sbom",
      "name": "SBOM 生成",
      "purpose": "生成覆盖声明 Gradle 项目的聚合 CycloneDX JSON；不把聚合 BOM 冒充逐制品 SBOM",
      "needs": [
        "build"
      ],
      "commands": [
        "./gradlew --no-daemon cyclonedxBom"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/reports/bom.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "sign",
      "name": "制品签名与来源证明",
      "purpose": "按校验后的全制品 manifest 对 JAR、manifest 与 SBOM 文件执行无密钥 blob 签名并生成 SLSA Build L1 provenance",
      "needs": [
        "build",
        "sbom",
        "python-floor",
        "unit-test",
        "ios-sdk-test",
        "flutter-sdk-test",
        "quality-metrics",
        "static-analysis",
        "dependency-scan",
        "container-scan",
        "iac-scan",
        "secret-scan",
        "negative-controls",
        "rule-knockout"
      ],
      "commands": [
        "scripts/sign-artifacts.sh"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG4",
      "artifacts": [
        "build/provenance.intoto.jsonl",
        "build/signatures/"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "negative-controls",
      "name": "运行期 fail-closed 验证",
      "purpose": "以真实 CLI 对被破坏的治理面验证门禁确实会失败",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/negative-controls.py > negative-controls.log 2>&1"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "negative-controls.log"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 10
    },
    {
      "id": "evidence-archive",
      "name": "证据归档",
      "purpose": "交叉校验两套编排实现和逐批完成证据，并生成受 GitHub retention 约束的仓库证据 tarball；任一批次不通过则拒绝出包",
      "needs": [
        "sign",
        "negative-controls",
        "rule-knockout"
      ],
      "commands": [
        "python3 scripts/batch.py crosscheck",
        "python3 scripts/validate-all.py",
        "python3 scripts/archive-evidence.py --out build/evidence-bundle.tar.gz"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/evidence-bundle.tar.gz"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 15
    },
    {
      "id": "rule-knockout",
      "name": "规则承重验证",
      "purpose": "逐条抑制校验规则并重跑其覆盖测试，测试仍通过即说明该规则不承重",
      "needs": [
        "governance"
      ],
      "commands": [
        "python3 scripts/rule-knockout.py --out build/rule-knockout.json"
      ],
      "required": true,
      "fail_closed": true,
      "gate": "RG1",
      "artifacts": [
        "build/rule-knockout.json"
      ],
      "if_no_files_found": "error",
      "timeout_minutes": 20
    }
  ],
  "source_security": {
    "languages": [
      "java-kotlin",
      "javascript-typescript",
      "python"
    ],
    "queries": "security-extended",
    "fail_on_any_result": true
  }
}
