{
  "schema_version": "1.0.0",
  "batch": "B21",
  "principle": "证书与密钥的事故几乎从不是「被破解」，而是**到期**、**换不动**和**撤销没生效**。因此这里管的不是算法，而是**时间**：每一份材料都有到期日、有提前量足够的告警、有新旧并存的重叠期、有一条被演练过的撤销与恢复路径。一条不能在旧材料仍然有效时就完成切换的轮换流程，等于没有轮换流程。",
  "lifecycle_stages": [
    "generate",
    "distribute",
    "activate",
    "overlap",
    "rotate",
    "revoke",
    "recover"
  ],
  "materials": [
    {
      "id": "edge-tls",
      "kind": "tls_certificate",
      "subject": "pay.example.invalid",
      "issuer": "public_ca",
      "key_id": "kek-provider-credentials",
      "validity_days": 90,
      "renew_before_days": 31,
      "overlap_days": 7,
      "automated_renewal": true,
      "revocation": "ocsp_must_staple",
      "owner": "platform-security",
      "notes": "对外 TLS 证书，ACME 自动续期。90 天有效期配 30 天提前量：即使续期连续失败两周，仍有人来得及处理。"
    },
    {
      "id": "internal-mtls",
      "kind": "tls_certificate",
      "subject": "*.internal.pay.example.invalid",
      "issuer": "workload-ca",
      "key_id": "kek-provider-credentials",
      "validity_days": 7,
      "renew_before_days": 3,
      "overlap_days": 1,
      "automated_renewal": true,
      "revocation": "short_lived",
      "owner": "platform-security",
      "notes": "服务间 mTLS 证书，7 天有效期。短寿命本身就是撤销机制：不需要 CRL 也能在一周内自然失效。"
    },
    {
      "id": "provider-signing-wechat",
      "kind": "signing_key",
      "subject": "wechat-merchant",
      "issuer": "provider",
      "key_id": "kek-provider-credentials",
      "validity_days": 365,
      "renew_before_days": 60,
      "overlap_days": 30,
      "automated_renewal": false,
      "revocation": "provider_console",
      "owner": "payments-integration",
      "notes": "渠道签名私钥由渠道方签发，只能人工轮换，因此提前量与重叠期都要更长：**重叠期内新旧密钥都必须能验签**，否则切换瞬间会拒绝所有回调。"
    },
    {
      "id": "provider-signing-alipay",
      "kind": "signing_key",
      "subject": "alipay-app",
      "issuer": "provider",
      "key_id": "kek-provider-credentials",
      "validity_days": 365,
      "renew_before_days": 60,
      "overlap_days": 30,
      "automated_renewal": false,
      "revocation": "provider_console",
      "owner": "payments-integration",
      "notes": "支付宝应用私钥同样由渠道方签发、人工轮换。到期未换的后果不是「降级」而是**全部支付请求签名失败**，因此提前量与重叠期与微信一致。"
    },
    {
      "id": "webhook-verification",
      "kind": "verification_key",
      "subject": "provider-webhooks",
      "issuer": "provider",
      "key_id": "kek-provider-credentials",
      "validity_days": 180,
      "renew_before_days": 60,
      "overlap_days": 14,
      "automated_renewal": true,
      "revocation": "key_set_rotation",
      "owner": "payments-integration",
      "notes": "验签公钥集合。渠道方可能**不打招呼就换密钥**，因此必须支持同时持有多把公钥并按 key id 选择。"
    },
    {
      "id": "workload-ca-root",
      "kind": "ca_certificate",
      "subject": "workload-ca",
      "issuer": "self",
      "key_id": "root-hsm",
      "validity_days": 1825,
      "renew_before_days": 365,
      "overlap_days": 180,
      "automated_renewal": false,
      "revocation": "trust_store_rollout",
      "owner": "platform-security",
      "notes": "工作负载 CA 根证书。轮换要提前一年开始，因为**信任库的分发比证书本身慢得多**：所有节点都信任新根之前，不能停用旧根。"
    },
    {
      "id": "token-signing",
      "kind": "signing_key",
      "subject": "platform-tokens",
      "issuer": "self",
      "key_id": "kek-provider-credentials",
      "validity_days": 90,
      "renew_before_days": 31,
      "overlap_days": 7,
      "automated_renewal": true,
      "revocation": "jwks_removal",
      "owner": "platform-security",
      "notes": "平台自签令牌的签名密钥（B17）。JWKS 中新旧公钥并存 7 天，保证在途令牌不会因轮换而失效。"
    },
    {
      "id": "apple-pay-processing",
      "kind": "signing_key",
      "subject": "apple_pay-processing",
      "issuer": "provider",
      "key_id": "kek-provider-credentials",
      "validity_days": 365,
      "renew_before_days": 60,
      "overlap_days": 30,
      "automated_renewal": false,
      "revocation": "provider_console",
      "owner": "payments-integration",
      "notes": "Apple Pay 支付处理私钥，用于解密支付令牌。它由 HSM 托管（B20），但**托管不等于有到期日**——这条记录就是为了让它有。"
    }
  ],
  "domains": [
    {
      "name": "pay.example.invalid",
      "purpose": "checkout",
      "registrar_lock": true,
      "dnssec": true,
      "expires_in_days": 400,
      "renew_before_days": 90,
      "caa_records": [
        "public_ca"
      ],
      "owner": "platform-security",
      "notes": "收银台主域名。注册商锁 + DNSSEC + CAA：域名被劫持时，攻击者能签出「合法」证书，TLS 就再也证明不了任何事。"
    },
    {
      "name": "api.pay.example.invalid",
      "purpose": "merchant_api",
      "registrar_lock": true,
      "dnssec": true,
      "expires_in_days": 400,
      "renew_before_days": 90,
      "caa_records": [
        "public_ca"
      ],
      "owner": "platform-security",
      "notes": "商户 API 域名。"
    },
    {
      "name": "internal.pay.example.invalid",
      "purpose": "internal",
      "registrar_lock": true,
      "dnssec": true,
      "expires_in_days": 400,
      "renew_before_days": 90,
      "caa_records": [
        "workload-ca"
      ],
      "owner": "platform-security",
      "notes": "内部域名，CAA 只允许自建 CA 签发——公共 CA 不应该能为它签证书。"
    }
  ],
  "alerting": {
    "channels": [
      "on_call",
      "security_team",
      "ticket"
    ],
    "expiry_warning_ratio": 0.34,
    "escalate_after_failed_renewals": 2,
    "alert_on_unexpected_issuer": true,
    "certificate_transparency_monitoring": true,
    "notes": "到期告警必须在「剩余时间 < 提前量」时触发，并在连续两次自动续期失败后升级为人工处理。同时监控 CT 日志：任何为我们的域名签出的、不是我们申请的证书，都是事故信号。"
  },
  "recovery": {
    "rehearsed": true,
    "rehearsal_interval_days": 180,
    "max_recovery_hours": 4,
    "offline_backup_of_ca": true,
    "quorum_required": true,
    "notes": "灾难恢复必须被**演练过**：一条从未走过的恢复流程在事故当天是不可信的。CA 材料有离线备份，恢复需要法定人数，目标 4 小时内恢复签发能力。"
  },
  "forbidden": {
    "wildcard_for_internal": false,
    "self_signed_at_edge": false,
    "manual_renewal_for_short_lived": false,
    "shared_key_across_environments": false,
    "notes": "边缘不得使用自签证书；短寿命材料不得依赖人工续期（7 天有效期 + 人工续期 = 每周一次的停机赌博）；生产与非生产不得共用密钥。"
  }
}
