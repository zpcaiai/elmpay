          "name": "payment_intent_id",
          "type": "uuid",
          "classification": "internal"
        },
        {
          "name": "project_id",
          "type": "uuid",
          "classification": "internal"
        },
        {
          "name": "provider",
          "type": "string",
          "classification": "internal"
        },
        {
