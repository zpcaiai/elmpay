      ],
      "notes": "把一个 unknown 定责为成功。这条事件的存在本身就是 AC-01 的对策：超时不会被静默判失败，它会一直挂在 unknown 上，直到有人发出这条事件。"
    }
  ],
  "consumers": [
    {
      "module": "ledger-service",
      "order_tolerance": "revision_guarded",
      "policy": "按 (aggregate_id, revision) 单调应用；revision 不大于已应用值的事件直接丢弃并记数。",
      "subscribes": [
        "payment_intent.authorized",
        "payment_intent.captured",
        "payment_intent.capture_closed",
        "payment_intent.voided",
        "refund.succeeded",
        "dispute.opened",
        "dispute.lost",
        "reconciliation.exception_opened",
        "payment_attempt.succeeded",
        "payment_attempt.resolved"
      ]
    },
    {
      "module": "risk-engine",
      "order_tolerance": "idempotent_apply",
      "policy": "风控特征写入是幂等 upsert，重复或乱序不改变结果。",
      "subscribes": [
        "payment_intent.authorized",
        "payment_intent.failed",
        "dispute.opened",
        "dispute.lost",
        "reconciliation.exception_opened",
        "payment_attempt.resolved"
      ]
    },
    {
      "module": "reconciliation-service",
      "order_tolerance": "buffer_and_reorder",
      "policy": "按 aggregate 缓冲最多 revision_gap_limit 个空洞，超时后升级为对账例外。",
      "subscribes": [
        "payment_intent.captured",
        "payment_intent.capture_closed",
        "refund.succeeded",
        "payment_attempt.unresolved",
        "payment_attempt.succeeded"
      ]
    },
    {
      "module": "webhook-delivery",
      "order_tolerance": "idempotent_apply",
      "policy": "对外投递按 event_id 去重；乱序由订阅方自行处理，我们只保证不丢不重发同一 event_id。",
      "subscribes": [
        "payment_intent.authorized",
        "payment_intent.captured",
        "payment_intent.capture_closed",
        "payment_intent.failed",
        "payment_intent.canceled",
        "payment_intent.voided",
        "refund.succeeded",
        "refund.failed",
        "dispute.opened",
        "dispute.lost",
        "subscription.past_due",
        "reconciliation.exception_opened",
        "payment_attempt.succeeded",
        "payment_attempt.resolved"
      ]
    },
    {
      "module": "worker-scheduler",
      "order_tolerance": "idempotent_apply",
      "policy": "调度任务按 (aggregate_id, period) 唯一，重复事件不会排出第二个任务。",
      "subscribes": [
        "payment_attempt.unresolved",
        "subscription.past_due"
      ]
    }
  ]
}
