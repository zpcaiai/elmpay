{
  "schema_version": "1.0.0",
  "batch": "B12",
  "delivery": {
    "transport_guarantee": "at_least_once",
    "business_guarantee": "effectively_once",
    "policy": "传输层只承诺至少一次。恰好一次的**业务效果**由 inbox 去重 + 消费方幂等达成，而不是靠一个声称 exactly-once 的中间件。任何声称传输层恰好一次的设计都要被拒绝。"
  },
  "envelope": {
    "required_fields": [
      "event_id",
      "event_name",
      "event_version",
      "tenant_id",
      "project_id",
      "aggregate_type",
      "aggregate_id",
      "revision",
      "occurred_at",
      "recorded_at",
      "trace_id",
      "payload"
    ],
    "id_field": "event_id",
    "revision_field": "revision",
    "occurred_field": "occurred_at",
    "policy": "信封字段固定；payload 里的内容按事件目录逐条声明。revision 单调递增，是乱序容忍的唯一依据——occurred_at 会因时钟漂移倒退。"
  },
  "forbidden_payload_fields": [
    "pan",
    "card_number",
    "cvv",
    "cvc",
    "track_data",
    "full_token",
    "password",
    "api_key",
    "private_key"
  ],
  "classifications": [
    "internal",
    "restricted",
    "personal"
  ],
  "outbox": {
    "table": "outbox_event",
    "owner": "payment-core",
    "same_transaction_as_state_change": true,
    "unique_key": [
      "tenant_id",
      "aggregate_type",
      "aggregate_id",
      "revision"
    ],
    "dispatch": {
      "mode": "poll_then_publish",
      "batch_size": 200,
      "backoff": "exponential",
      "initial_delay_ms": 200,
      "max_delay_ms": 60000,
      "max_attempts": 12,
      "dead_letter_table": "outbox_dead_letter"
    },
    "policy": "状态变更与 outbox 写入必须在同一个数据库事务里。先发布后提交会在崩溃时发出一条从未发生过的事件；先提交后发布只会导致延迟发布，这是可以接受的那一侧。"
  },
  "inbox": {
    "table": "provider_webhook_inbox",
    "owner": "webhook-ingress",
    "unique_key": [
      "source",
      "source_event_id"
    ],
    "payload_hash_field": "raw_body_sha256 + canonical_payload_sha256 + verification_digest",
    "conflict_error": "provider_event_identity_conflict",
    "retention_hours": 720,
    "policy": "同一租户、渠道、商户渠道账户与 provider_event_id 只处理一次；相同 ID 的原始摘要或 typed canonical 摘要不同即拒绝。原始 body 不持久化；业务 effect、effect commit marker 与 PROCESSED 标记在同一数据库事务提交。"
  },
  "ordering": {
    "key_field": "aggregate_id",
    "sequence_field": "revision",
    "tolerances": [
      "idempotent_apply",
      "revision_guarded",
      "buffer_and_reorder"
    ],
    "revision_gap_limit": 100,
    "policy": "乱序容忍以 revision 为准，不以 occurred_at 为准：时钟会漂移，序号不会。"
  },
  "versioning": {
    "policy": "事件版本只增不改。同一版本内只允许新增可选字段；删字段、改类型、改语义必须发新版本，并与旧版本并行至少 180 天。",
    "parallel_days": 180
  },
  "events": [
