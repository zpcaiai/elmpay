  "settlement": {
    "book_value_is_estimate": true,
    "authoritative_source": "provider_settlement_report",
    "mismatch_opens_reconciliation": true,
    "silent_overwrite_allowed": false,
    "tolerance_minor": 0,
    "max_settle_lag_days": 35,
    "notes": "账面值永远标记为估计，直到结算报告到达。差异**开对账项**而不是覆盖账面：覆盖之后，「我们当初以为收多少」这个问题就永远查不出来了。容差为 0：金额是整数，任何差异都是真差异。"
  },
  "split": {
    "parties": [
      "merchant",
      "platform",
      "provider",
      "authority"
    ],
    "must_sum_to_total": true,
    "residue_to": "platform",
    "notes": "四方之和必须精确等于总额；余数归平台，且这条必须写下来而不是靠实现顺序决定。"
  },
  "currency": {
    "fee_currency_equals_payment_currency": true,
    "implicit_conversion_allowed": false,
    "conversion_requires_rate_record": true,
    "rate_record_fields": [
      "rate",
      "quoted_at",
      "source"
    ],
    "notes": "隐式换算会把汇率损益藏进费用里，让费率看起来忽高忽低而没人知道为什么。跨币种必须有显式汇率记录。"
  },
  "metering": {
    "event_key": "payment_id",
    "idempotent": true,
    "recomputable": true,
    "retention_days": 1825,
    "notes": "计量事件按支付 ID 幂等：渠道重发、内部重试、补数任务都可能重复投递同一笔。可重算意味着任何一天的计量都能从原始事件重新推导，而不是只能相信当时写下的汇总。"
  },
  "audit_event_class": "money.movement",
  "basis_kinds": {
    "payment": "按支付金额计算。",
    "platform_service_fee": "按平台服务费计算——增值税等税项是对服务费计征，不是对支付金额。"
  }
