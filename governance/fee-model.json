{
  "schema_version": "1.0.0",
  "batch": "B29",
  "principle": "**账面模型不是资金事实**。我们算出来的费用是一个估计，真正被扣掉多少要等渠道结算报告说了算；两者不一致时唯一正确的动作是**开一条对账项**，而不是把账面悄悄改成渠道说的数——后者会让「我们以为收了多少」这个问题永远无法回答。其余三条同样是被现实教出来的：**税不是收入**，它是代收代缴，混进收入口径就是虚增；**分账各方之和必须等于总额**，一分钱的余数也必须有明确归属，「四舍五入后差一分」是对账系统里最常见也最难查的差异；**费用币种必须等于支付币种**，跨币种必须有显式汇率记录，隐式换算会把汇率损益藏进费用里。",
  "categories": [
    {
      "id": "provider_cost",
      "is_revenue": false,
      "charged_to_merchant": true,
      "remitted_to_authority": false,
      "notes": "渠道成本：渠道实际收走的钱，账面值是估计，以结算报告为准。"
    },
    {
      "id": "platform_service_fee",
      "is_revenue": true,
      "charged_to_merchant": true,
      "remitted_to_authority": false,
      "notes": "平台服务费：唯一属于平台收入的类别。"
    },
    {
      "id": "tax",
      "is_revenue": false,
      "charged_to_merchant": true,
      "remitted_to_authority": true,
      "notes": "税费：代收代缴，**不得计入收入**；混进收入口径就是虚增。"
    },
    {
      "id": "internal_cost",
      "is_revenue": false,
      "charged_to_merchant": false,
      "remitted_to_authority": false,
      "notes": "内部成本：风控、客服、资金占用等，**不向商户收取**，只用于毛利口径。"
    }
  ],
  "rounding": {
    "mode": "half_up",
    "unit": "minor",
    "declared": true,
    "sum_must_equal_total": true,
    "remainder_owner": "platform",
    "notes": "舍入方式必须写死并可复现；余数必须有归属。把余数留给「谁先算谁拿」是对账差异的经典来源——它每天只差一分钱，但一年之后没有人能解释那笔钱去了哪。"
  },
