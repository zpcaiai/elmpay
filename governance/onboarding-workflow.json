{
  "schema_version": "1.0.0",
  "batch": "B30",
  "principle": "接入流程必须**可恢复**。一个不能从中断处继续的工作流，最终都是靠人手工做完的：第六步里第四步在凌晨失败，运维要么从头再来（重新导凭证、重新验域名，昂贵且有时不可能），要么——更常见——「直接去库里把状态改成已上线」。那一刻，前面所有审批记录都失去意义。所以本批次不提供任何手工完成路径，每一步都幂等、状态都落盘、恢复时**绝不重放已完成的副作用**。另外三条同样是被现实教出来的：**批准必须绑定被批准的内容**——先批准再改收款账户是最经典的绕过；**批准会过期**——半年前批准的是另一个世界；**停用必须比上线容易**——给停用加四眼审批，等于在事故里多等一个人醒来。",
  "steps": [
    {
      "id": "import_credentials",
      "order": 10,
      "has_side_effect": true,
      "idempotent": true,
      "resumable": true,
      "requires_approval": false,
      "evidence_required": "credential_reference",
      "notes": "导入渠道凭证：有副作用且**不可回显**，导入后只能使用不能读取。幂等键是绑定，重复导入返回同一引用而不是再存一份。"
    },
    {
      "id": "verify_domain",
      "order": 20,
      "has_side_effect": false,
      "idempotent": true,
      "resumable": true,
      "requires_approval": false,
      "evidence_required": "dns_txt_record",
      "notes": "域名验证：证明请求方控制该域名，回调地址才有意义。"
    },
    {
      "id": "verify_callback",
      "order": 30,
      "has_side_effect": true,
      "idempotent": true,
      "resumable": true,
      "requires_approval": false,
      "evidence_required": "callback_roundtrip_id",
      "notes": "回调验证：发一笔测试交易并等回调验签通过——这与 B26 的激活条件是同一件事，此处只是把它编进工作流。"
    },
    {
      "id": "set_limits",
      "order": 40,
      "has_side_effect": false,
      "idempotent": true,
      "resumable": true,
      "requires_approval": false,
      "evidence_required": "limit_snapshot",
      "notes": "设置限额：必须在上线前完成，默认值取自 B25 的风险等级。"
    },
    {
      "id": "approve",
      "order": 50,
      "has_side_effect": false,
      "idempotent": true,
      "resumable": true,
      "requires_approval": true,
      "evidence_required": "approval_record",
      "notes": "四眼审批：批准绑定到申请内容摘要，任何改动都会作废它。"
    },
    {
      "id": "go_live",
      "order": 60,
      "has_side_effect": true,
      "idempotent": true,
      "resumable": true,
      "requires_approval": false,
      "evidence_required": "binding_state",
      "notes": "上线：把 B26 的绑定从 pending 切到 active，是整个流程唯一改变资金能力的一步。"
    }
  ],
  "approval": {
    "eyes_required": 2,
    "approver_differs_from_requester": true,
    "bound_to_digest": true,
    "digest_fields": [
      "tenant_id",
      "provider",
      "payout_account",
      "limits",
      "domains"
    ],
    "expires_hours": 72,
    "reapproval_required_on_change": true,
    "permission": "config.write",
    "notes": "批准的是**一份具体内容**，不是「这个申请」。摘要覆盖收款账户与限额：先批准、再改收款账户、然后上线，是这条流程最经典的绕过方式。72 小时后过期，因为半年前批准的是另一个世界。"
  },
  "resumption": {
    "state_persisted": true,
    "resume_from_last_completed_step": true,
    "replay_completed_side_effects": false,
    "manual_completion_allowed": false,
    "max_resume_days": 30,
    "notes": "恢复从最后一个已完成步骤之后开始，且**不重放已完成的副作用**——重放导入凭证会多存一份，重放上线会重复发事件。没有手工完成路径：只要留一个，它就会在某个凌晨被用掉。"
  },
  "domain_verification": {
    "method": "dns_txt",
    "token_single_use": true,
    "token_expires_hours": 168,
    "wildcard_allowed": false,
    "notes": "DNS TXT 证明控制权；令牌一次性且有有效期。不接受通配符：一个 `*.example.com` 的证明会把所有子域一起放进来。"
  },
  "callback_verification": {
    "roundtrip_required": true,
    "signature_required": true,
    "https_required": true,
    "private_address_allowed": false,
    "notes": "回调地址必须是 HTTPS 且不能指向内网地址——一个指向 169.254.169.254 的「回调地址」是让平台替人访问自己元数据服务的请求。"
  },
  "credentials": {
    "echo_back_allowed": false,
    "import_once": true,
    "stored_via_binding": true,
    "notes": "导入的凭证永不回显。「让我确认一下我填对了没有」这个需求真实存在，但满足它就等于提供了一个读取全部渠道密钥的接口。"
  },
  "limits": {
    "must_be_set_before_go_live": true,
    "default_from_risk_level": true,
    "raise_requires_approval": true,
    "notes": "限额必须在上线前存在；调高限额本身也是一次需要审批的变更。"
  },
  "suspension": {
    "approvals_required": 1,
    "immediate": true,
    "reinstatement_approvals_required": 2,
    "notes": "停用一个人就能做，且立即生效；恢复需要两个人。这个不对称是有意的：给停用加审批，等于在事故里多等一个人醒来。"
  },
  "audit_event_class": "config.change"
}
