{
  "schema_version": "1.0.0",
  "batch": "B17",
  "principle": "身份必须是**短期的、有受众的、绑定到持有者的**。只要还存在一张长期、无受众、谁拿到都能用的凭据，前面所有的零信任判定都可以被绕过。",
  "bearer_tokens_allowed": false,
  "binding_methods": [
    "dpop",
    "mtls"
  ],
  "token_kinds": [
    "access",
    "refresh",
    "id",
    "workload_certificate"
  ],
  "forbidden_algorithms": [
    "none",
    "HS256",
    "HS384",
    "HS512"
  ],
  "oauth": {
    "allowed_flows": [
      "authorization_code"
    ],
    "forbidden_flows": [
      "implicit",
      "resource_owner_password",
      "device_code_for_admin"
    ],
    "pkce_required": true,
    "pkce_method": "S256",
    "redirect_uri_matching": "exact",
    "state_required": true,
    "nonce_required": true,
    "policy": "只允许授权码 + PKCE(S256)，重定向 URI 精确匹配。隐式流把令牌放进 URL，密码流让每个客户端都摸到用户密码——两者在支付场景里都不可接受。重定向 URI 前缀匹配等于开放重定向（NN-10）。"
  },
  "machine_oauth": {
    "allowed_flows": [
      "client_credentials"
    ],
    "static_client_secret_allowed": false,
    "client_authentication": "mtls",
    "access_token_binding": "mtls",
    "maximum_token_minutes": 5,
    "policy": "商户服务端只能用 mTLS 客户端认证换取最长 5 分钟且证书绑定的 access token；不接受静态 client_secret、密码流或无绑定 bearer token。"
  },
  "revocation": {
    "mechanism": "short_lifetime_plus_revocation_list",
    "propagation_seconds": 60,
    "check_on_every_request": true,
    "policy": "撤销 60 秒内全局生效，且每次请求都要检查。一个「等它过期」的撤销不是撤销。"
  },
  "session_binding": {
    "required": true,
    "methods": [
      "dpop",
      "mtls"
    ],
    "policy": "所有令牌必须绑定到持有者的密钥。无绑定的 bearer 令牌只要被复制就完全可用，而日志、代理、浏览器扩展与错误上报都在复制它。"
  },
  "service_accounts": {
    "static_secrets_allowed": false,
    "issuance": "workload_identity_only",
    "policy": "不存在带静态密码的服务账号。工作负载凭据由 CA 按身份签发、短期、自动轮换。"
  },
  "recovery": [
    {
      "subject": "customer",
      "methods": [
        "email_link_plus_reauth"
      ],
      "delay_hours": 0,
      "notify_channels": [
        "email"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "付款人恢复必须重新验证，且不得比原来的因素更弱。恢复流程是账号接管最常用的入口。"
    },
    {
      "subject": "merchant-admin",
      "methods": [
        "email_link_plus_reauth",
        "support_verified_identity"
      ],
      "delay_hours": 24,
      "notify_channels": [
        "email",
        "in_app"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "商户管理员恢复有 24 小时冷静期并全渠道通知——让真正的持有者有机会喊停。"
    },
    {
      "subject": "platform-operator",
      "methods": [
        "in_person_verified",
        "hardware_key_reissue"
      ],
      "delay_hours": 24,
      "notify_channels": [
        "email",
        "in_app",
        "security_team"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "运营账号恢复必须线下核验或重新签发硬件密钥。**短信恢复在这里是被明确禁止的**：SIM 交换会让最高权限账号一夜易主。"
    },
    {
      "subject": "break-glass",
      "methods": [
        "in_person_verified",
        "hardware_key_reissue"
      ],
      "delay_hours": 24,
      "notify_channels": [
        "security_team",
        "on_call",
        "audit_log"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "紧急通道账号的恢复必须线下核验并重新签发硬件密钥。**这条路径原先根本不存在**——B19 的特权角色清单把它暴露了出来：平台上权限最大的账号，恢复流程却是空白。"
    },
    {
      "subject": "merchant-finance",
      "methods": [
        "in_person_verified",
        "hardware_key_reissue"
      ],
      "delay_hours": 24,
      "notify_channels": [
        "email",
        "in_app",
        "security_team"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "商户财务恢复需与原因素同等或更强，并有冷静期与多渠道通知。"
    },
    {
      "subject": "risk-analyst",
      "methods": [
        "in_person_verified",
        "hardware_key_reissue"
      ],
      "delay_hours": 24,
      "notify_channels": [
        "security_team",
        "in_app",
        "audit_log"
      ],
      "requires_same_or_stronger_factor": true,
      "sms_only_allowed": false,
      "notes": "风控分析师恢复同样不得降级；能改规则的账号被接管，攻击者可以让自己的交易永远不被拦。"
    }
  ],
  "providers": [
    {
      "id": "customer-idp",
      "purpose": "付款人与商户后台用户",
      "issuer": "https://idp.example.invalid/customer",
      "audiences": [
        "checkout-web",
        "merchant-portal"
      ],
      "algorithms": [
        "RS256",
        "ES256"
      ],
      "jwks_rotation_days": 30,
      "max_token_minutes": 30,
      "clock_skew_seconds": 60,
      "notes": "面向外部用户的 IdP。只允许非对称签名——共享密钥意味着任何一个验证方都能伪造发行方签发的令牌。"
    },
    {
      "id": "merchant-authorization-server",
      "purpose": "商户服务端 OAuth2 client credentials",
      "issuer": "https://identity.elmpay.example/merchant",
      "audiences": [
        "elmpay-api"
      ],
      "algorithms": [
        "RS256"
      ],
      "jwks_rotation_days": 30,
      "max_token_minutes": 5,
      "clock_skew_seconds": 60,
      "notes": "商户机器身份使用 mTLS 客户端认证；签发的 at+jwt 同时绑定 tenant/project/merchant 与客户端证书，不与内部 workload CA 共用受众。"
    },
    {
      "id": "corporate-idp",
      "purpose": "平台运营与紧急通道",
      "issuer": "https://idp.example.invalid/corp",
      "audiences": [
        "admin-web"
      ],
      "algorithms": [
        "ES256"
      ],
      "jwks_rotation_days": 30,
      "max_token_minutes": 60,
      "clock_skew_seconds": 60,
      "notes": "企业 IdP，绑定抗钓鱼 MFA（B18）。运营会话最长 60 分钟，与 B16 的上限一致。"
    },
    {
      "id": "workload-ca",
      "purpose": "服务与连接器工作负载",
      "issuer": "spiffe://elmpay.invalid",
      "audiences": [
        "internal-api",
        "provider-egress"
      ],
      "algorithms": [
        "ES256"
      ],
      "jwks_rotation_days": 1,
      "max_token_minutes": 60,
      "clock_skew_seconds": 60,
      "notes": "工作负载证书由平台 CA 签发，每天轮换、60 分钟有效。它不是 IdP 而是 CA，令牌就是那张证书。"
    },
    {
      "id": "ci-oidc",
      "purpose": "CI 流水线",
      "issuer": "https://ci.example.invalid",
      "audiences": [
        "artifact-registry",
        "cloud-control-plane"
      ],
      "algorithms": [
        "RS256"
      ],
      "jwks_rotation_days": 30,
      "max_token_minutes": 15,
      "clock_skew_seconds": 60,
      "notes": "CI 用 OIDC 联合换取 15 分钟云凭据，仓库里不存任何长期密钥（NN-07）。"
    }
  ],
  "tokens": [
    {
      "id": "payer-session",
      "kind": "access",
      "provider": "customer-idp",
      "audience": "checkout-web",
      "lifetime_minutes": 30,
      "binding": "dpop",
      "revocable": true,
      "notes": "付款人会话。绑定到客户端密钥：偷到令牌但没有私钥，令牌就是废纸。"
    },
    {
      "id": "merchant-portal-session",
      "kind": "access",
      "provider": "customer-idp",
      "audience": "merchant-portal",
      "lifetime_minutes": 30,
      "binding": "dpop",
      "revocable": true,
      "notes": "商户后台会话，同样绑定客户端密钥。"
    },
    {
      "id": "merchant-api-access",
      "kind": "access",
      "provider": "merchant-authorization-server",
      "audience": "elmpay-api",
      "lifetime_minutes": 5,
      "binding": "mtls",
      "revocable": true,
      "notes": "商户服务端 API access token；最长 5 分钟，绑定客户端证书和租户/项目/商户声明。"
    },
    {
      "id": "operator-session",
      "kind": "access",
      "provider": "corporate-idp",
      "audience": "admin-web",
      "lifetime_minutes": 60,
      "binding": "dpop",
      "revocable": true,
      "notes": "运营会话。60 分钟到期，且必须可在 60 秒内撤销（与 B16 一致）。"
    },
    {
      "id": "workload-cert",
      "kind": "workload_certificate",
      "provider": "workload-ca",
      "audience": "internal-api",
      "lifetime_minutes": 60,
      "binding": "mtls",
      "revocable": true,
      "notes": "工作负载证书。绑定方式就是 mTLS 本身——私钥不出工作负载。"
    },
    {
      "id": "egress-cert",
      "kind": "workload_certificate",
      "provider": "workload-ca",
      "audience": "provider-egress",
      "lifetime_minutes": 60,
      "binding": "mtls",
      "revocable": true,
      "notes": "出站到渠道的证书，与内部 API 证书是不同受众，互相不可用。"
    },
    {
      "id": "ci-cloud-token",
      "kind": "access",
      "provider": "ci-oidc",
      "audience": "cloud-control-plane",
      "lifetime_minutes": 15,
      "binding": "mtls",
      "revocable": true,
      "notes": "CI 换来的云凭据，15 分钟，用完即弃。"
    },
    {
      "id": "ci-registry-token",
      "kind": "access",
      "provider": "ci-oidc",
      "audience": "artifact-registry",
      "lifetime_minutes": 15,
      "binding": "mtls",
      "revocable": true,
      "notes": "CI 发布制品用的令牌，受众与云控制面分开。"
    }
  ],
  "principal_bindings": [
    {
      "principal": "payer",
      "provider": "customer-idp",
      "token": "payer-session"
    },
    {
      "principal": "merchant-api-client",
      "provider": "merchant-authorization-server",
      "token": "merchant-api-access"
    },
    {
      "principal": "platform-operator",
      "provider": "corporate-idp",
      "token": "operator-session"
    },
    {
      "principal": "service-workload",
      "provider": "workload-ca",
      "token": "workload-cert"
    },
    {
      "principal": "connector-egress",
      "provider": "workload-ca",
      "token": "egress-cert"
    },
    {
      "principal": "ci-pipeline",
      "provider": "ci-oidc",
      "token": "ci-cloud-token"
    },
    {
      "principal": "break-glass",
      "provider": "corporate-idp",
      "token": "operator-session"
    }
  ]
}
