{
  "schema_version": "1.0.0",
  "batch": "B14",
  "call_kinds": [
    "sync",
    "async"
  ],
  "criticality_tiers": [
    "tier1",
    "tier2",
    "tier3"
  ],
  "runtime_kinds": [
    "gateway",
    "api",
    "worker",
    "app"
  ],
  "external_dependencies": [
    "risk-signal",
    "risk-model"
  ],
  "policy": {
    "max_sync_depth": 3,
    "sync_budget_rule": "调用方的预算必须覆盖它所有同步依赖的超时之和；否则超时设置只是装饰，真正生效的是调用方自己先被上游掐断。",
    "money_path_failure_mode": "fail_closed",
    "money_path_note": "资金路径上的依赖不可用时必须拒绝，不得放行；唯一例外是渠道不可用——那时 attempt 进入 unknown 而不是 failed（AC-01）。",
    "database_access": "exclusive_per_owner",
    "database_note": "服务只能访问自己拥有的表。共享数据库表是分布式单体的定义。"
  },
  "services": [
    {
      "name": "edge-gateway",
      "module": "edge-gateway",
      "runtime": "gateway",
      "criticality": "tier1",
      "request_budget_ms": 3000,
      "slo": {
        "availability": "99.99%",
        "p99_ms": 3000
      },
      "inbound": [
        "Payments API v1"
      ],
      "dependencies": [
        {
          "target": "payment-core",
          "kind": "sync",
          "reason": "所有对外支付 API 都经网关进入支付核心",
          "timeout_ms": 2500,
          "retries": 0,
          "circuit_breaker": {
            "error_rate_threshold_pct": 50,
            "min_requests": 20,
            "open_seconds": 30,
            "half_open_probes": 3
          },
          "bulkhead": {
            "max_concurrent": 400,
            "queue": 0
          },
          "degradation": "返回 provider_unavailable(502)，不生成任何支付事实",
          "failure_mode": "fail_closed"
        },
        {
          "target": "merchant-config",
          "kind": "sync",
          "reason": "鉴权与租户解析需要商户配置",
          "timeout_ms": 150,
          "retries": 1,
          "circuit_breaker": {
            "error_rate_threshold_pct": 50,
            "min_requests": 20,
            "open_seconds": 30,
            "half_open_probes": 3
          },
          "bulkhead": {
            "max_concurrent": 100,
            "queue": 0
          },
          "degradation": "使用本地缓存的商户配置，缓存过期则拒绝请求",
          "failure_mode": "fail_closed"
        }
      ],
      "publishes": [],
      "consumes": [],
      "notes": "网关不拥有支付、风控或发布领域事实；它只写自身拥有的鉴权重放、幂等、审计和 admin_domain_command 信封/回执查询状态。领域命令效果必须由所属服务在本地事务中应用，网关不得跨所有者直写。"
    },
