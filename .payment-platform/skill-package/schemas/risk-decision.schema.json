{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "decision_id",
    "action",
    "score",
    "reasons",
    "policy_version",
    "evaluated_at"
  ],
  "properties": {
    "decision_id": {
      "type": "string"
    },
    "action": {
      "enum": [
        "allow",
        "challenge",
        "review",
        "deny"
      ]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "policy_version": {
      "type": "string"
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "feature_time": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
